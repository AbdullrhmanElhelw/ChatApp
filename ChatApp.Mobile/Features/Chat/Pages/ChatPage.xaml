<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Chat.ViewModels"
             xmlns:dto="clr-namespace:ChatApp.Mobile.Features.Chat.DTOs"
             xmlns:converters="clr-namespace:ChatApp.Mobile.Converters"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Chat.Pages.ChatPage"
             x:Name="ChatPageRoot"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource ChatCanvasLight}, Dark=#13101A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

        <!-- Dynamic Chat Background Brush & Optional Custom Wallpaper -->
        <BoxView Grid.RowSpan="6" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="{Binding ChatBackgroundStartColor}" Offset="0.0" />
                    <GradientStop Color="{Binding ChatBackgroundEndColor}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <Image Grid.RowSpan="6"
               Source="{Binding CustomWallpaperPath}"
               Aspect="AspectFill"
               Opacity="0.38"
               IsVisible="{Binding HasCustomWallpaper}"
               InputTransparent="True" />

        <!-- 1. Sleek Header / Top Bar (Mockup Style) -->
        <Border Grid.Row="0"
                StrokeThickness="0,0,0,1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#262033}"
                BackgroundColor="#CC13101A"
                Padding="14,10">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button -->
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#252131}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconArrowRight}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark=#FFFFFF}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Partner Avatar + Name + Online Status (Right-aligned next to Back in RTL) -->
                <HorizontalStackLayout Grid.Column="1"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Spacing="10">
                    <controls:AvatarView FullName="{Binding ChatTitle}"
                                         AvatarUrl="{Binding AvatarUrl}"
                                         Size="40"
                                         IsOnline="{Binding IsPartnerOnline}"
                                         VerticalOptions="Center" />

                    <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding ChatTitle}"
                               FontFamily="CairoBold"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}"
                               LineBreakMode="TailTruncation"
                               MaximumWidthRequest="170" />

                        <Label Text="{Binding PartnerTypingText}"
                               FontFamily="CairoBold"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandNeonPink}"
                               IsVisible="{Binding IsPartnerTyping}" />

                        <Label Text="{Binding PartnerPresenceText}"
                               FontFamily="CairoRegular"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#9B86B8}"
                               IsVisible="{Binding ShowPartnerPresence}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Actions: Search & Customize -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#252131}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconSearch}"
                              Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark=#FFFFFF}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#252131}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCustomizeSheetCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconPalette}"
                              Fill="{StaticResource BrandNeonPink}"
                              WidthRequest="17"
                              HeightRequest="17"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 2. Search Bar + Message Feed -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Collapsible In-Chat Search Bar -->
            <Border Grid.Row="0"
                    IsVisible="{Binding IsSearchOpen}"
                    StrokeThickness="1"
                    Stroke="{StaticResource BrandPrimaryLight}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}"
                    Padding="12,4"
                    Margin="12,8,12,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Path Grid.Column="0"
                          Data="{StaticResource IconSearch}"
                          Fill="{StaticResource BrandPrimaryLight}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchQuery, Mode=TwoWay}"
                           Placeholder="ابحث في رسائل هذه المحادثة..."
                           FontFamily="CairoRegular"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                    <Border Grid.Column="2"
                            WidthRequest="28"
                            HeightRequest="28"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <CollectionView x:Name="MessagesList"
                            Grid.Row="1"
                            ItemsSource="{Binding DisplayedMessages}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                    <!-- E2EE Encryption Pill (Vector Lock Icon) -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            Padding="14,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.4" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconLock}"
                                  Fill="{StaticResource BrandNeonPink}"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="محادثاتك في BetweenUs خاصة بينكما"
                                   FontFamily="CairoRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ChatMessageItem">
                    <Grid Padding="16,2">
                        <!-- Outgoing Bubble (Mine) - Signal Royal Cobalt Style (RTL: Start = Right) -->
                        <VerticalStackLayout HorizontalOptions="Start"
                                             MaximumWidthRequest="340"
                                             Spacing="3"
                                             IsVisible="{Binding IsOutgoingNormal}">
                            <Border x:Name="OutgoingBubble"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding Source={x:Reference ChatPageRoot}, Path=BindingContext.OutgoingBubbleStartColor}"
                                    Padding="16,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20,20,4,20" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#8E30F5" Offset="0,3" Radius="10" Opacity="0.32" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnMessageBubblePointerPressed"
                                                              PointerReleased="OnMessageBubblePointerReleased"
                                                              PointerExited="OnMessageBubblePointerExited" />
                                    <PanGestureRecognizer PanUpdated="OnMessageBubblePanUpdated" />
                                    <SwipeGestureRecognizer Direction="Left"
                                                            Threshold="35"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                            CommandParameter="{Binding .}" />
                                    <SwipeGestureRecognizer Direction="Right"
                                                            Threshold="35"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                            CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                          CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer Buttons="Secondary"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="5">
                                    <!-- Quoted Reply Inset Card -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="#22FFFFFF"
                                            Padding="10,6"
                                            StrokeThickness="0"
                                            Margin="0,0,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                                            <BoxView Grid.Column="0" Color="#FFFFFF" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding DisplayReplySender}"
                                                       FontFamily="CairoBold"
                                                       FontSize="11"
                                                       TextColor="#FFB5DC"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding ReplyToContent}"
                                                       FontFamily="CairoRegular"
                                                       FontSize="11"
                                                       TextColor="#F7ECFA"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Text Message Content -->
                                    <Label Text="{Binding Content}"
                                           FontFamily="CairoRegular"
                                           FontSize="15"
                                           TextColor="{StaticResource White}"
                                           LineBreakMode="WordWrap"
                                           HorizontalTextAlignment="Start"
                                           IsVisible="{Binding IsTextMessage}" />

                                    <!-- Image Attachment Preview -->
                                    <Border StrokeThickness="0"
                                            MaximumWidthRequest="260"
                                            MaximumHeightRequest="260"
                                            IsVisible="{Binding IsImage}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding DisplayImageUrl}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Voice Message Player (Outgoing) -->
                                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsAudio}" VerticalOptions="Center" Padding="2,4">
                                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="#33FFFFFF">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChatPageRoot}, Path=BindingContext.TogglePlayAudioCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsPlayingAudio}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconPause}" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>
                                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                            <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="1.5" Color="#FFD6F2" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="20" CornerRadius="1.5" Color="#FFFFFF" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="1.5" Color="#FFD6F2" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="24" CornerRadius="1.5" Color="#FFFFFF" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="16" CornerRadius="1.5" Color="#FFD6F2" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="22" CornerRadius="1.5" Color="#FFFFFF" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="1.5" Color="#FFD6F2" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DisplayAudioTime}" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Clean Timestamp & Read Status Row (WhatsApp Style) -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding FormattedTime}"
                                               FontFamily="CairoRegular"
                                               FontSize="10"
                                               TextColor="#FFB5DC"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding StatusIcon}"
                                               FontSize="11"
                                               TextColor="#FFB5DC"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Reaction Pills Row (Under Outgoing Bubble) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F7ECFA, Dark=#39274F}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FCE7F3, Dark=#4E1688}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Outgoing Sticker (Mine) - Borderless Floating Sticker (RTL: Start = Right) -->
                        <VerticalStackLayout HorizontalOptions="Start"
                                             Spacing="3"
                                             IsVisible="{Binding IsOutgoingSticker}">
                            <Grid>
                                <VerticalStackLayout Spacing="4">
                                    <!-- Quoted Reply Inset Card for Sticker -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="#22FFFFFF"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            MaximumWidthRequest="150"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="6">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ReplyToContent}"
                                                   FontFamily="CairoRegular"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <PointerGestureRecognizer PointerPressed="OnMessageBubblePointerPressed"
                                                                      PointerReleased="OnMessageBubblePointerReleased"
                                                                      PointerExited="OnMessageBubblePointerExited" />
                                            <PanGestureRecognizer PanUpdated="OnMessageBubblePanUpdated" />
                                            <SwipeGestureRecognizer Direction="Left"
                                                                    Threshold="35"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            <SwipeGestureRecognizer Direction="Right"
                                                                    Threshold="35"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            <TapGestureRecognizer NumberOfTapsRequired="2"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                  CommandParameter="{Binding .}" />
                                            <TapGestureRecognizer Buttons="Secondary"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="{Binding StickerUrl}"
                                               WidthRequest="150"
                                               HeightRequest="150"
                                               Aspect="AspectFit" />
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="End"
                                                Margin="0,0,4,4"
                                                StrokeThickness="0"
                                                BackgroundColor="#90000000"
                                                Padding="7,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding FormattedTime}"
                                                       FontSize="10"
                                                       TextColor="#F8FAFC" />
                                                <Label Text="{Binding StatusIcon}"
                                                       FontSize="11"
                                                       TextColor="{Binding StatusColor}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Reaction Pills Row (Under Outgoing Sticker) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F7ECFA, Dark=#39274F}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FCE7F3, Dark=#4E1688}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Incoming Bubble (Partner) - Slate Surface Style (RTL: End = Left) -->
                        <VerticalStackLayout HorizontalOptions="End"
                                             MaximumWidthRequest="340"
                                             Spacing="3"
                                             IsVisible="{Binding IsIncomingNormal}">
                            <Border x:Name="IncomingBubble"
                                    StrokeThickness="{AppThemeBinding Light=1, Dark=0}"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#252131}"
                                    Padding="16,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20,20,20,4" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.5" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnMessageBubblePointerPressed"
                                                              PointerReleased="OnMessageBubblePointerReleased"
                                                              PointerExited="OnMessageBubblePointerExited" />
                                    <PanGestureRecognizer PanUpdated="OnMessageBubblePanUpdated" />
                                    <SwipeGestureRecognizer Direction="Left"
                                                            Threshold="35"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                            CommandParameter="{Binding .}" />
                                    <SwipeGestureRecognizer Direction="Right"
                                                            Threshold="35"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                            CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                          CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer Buttons="Secondary"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="5">
                                    <!-- Quoted Reply Inset Card -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                            Padding="10,6"
                                            StrokeThickness="0"
                                            Margin="0,0,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding DisplayReplySender}"
                                                       FontFamily="CairoBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource BrandPrimary}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding ReplyToContent}"
                                                       FontFamily="CairoRegular"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Text Message Content -->
                                    <Label Text="{Binding Content}"
                                           FontFamily="CairoRegular"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           LineBreakMode="WordWrap"
                                           HorizontalTextAlignment="Start"
                                           IsVisible="{Binding IsTextMessage}" />

                                    <!-- Image Attachment Preview -->
                                    <Border StrokeThickness="0"
                                            MaximumWidthRequest="260"
                                            MaximumHeightRequest="260"
                                            IsVisible="{Binding IsImage}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding DisplayImageUrl}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Voice Message Player (Incoming) -->
                                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsAudio}" VerticalOptions="Center" Padding="2,4">
                                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="{StaticResource BrandNeonViolet}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ChatPageRoot}, Path=BindingContext.TogglePlayAudioCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsPlayingAudio}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconPause}" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Border>
                                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                            <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="1.5" Color="{StaticResource BrandNeonPink}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="20" CornerRadius="1.5" Color="{StaticResource BrandNeonViolet}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="1.5" Color="{StaticResource BrandNeonPink}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="24" CornerRadius="1.5" Color="{StaticResource BrandNeonViolet}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="16" CornerRadius="1.5" Color="{StaticResource BrandNeonPink}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="22" CornerRadius="1.5" Color="{StaticResource BrandNeonViolet}" VerticalOptions="Center" />
                                            <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="1.5" Color="{StaticResource BrandNeonPink}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DisplayAudioTime}" FontFamily="CairoBold" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Clean Timestamp Row (WhatsApp Style) -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding FormattedTime}"
                                               FontFamily="CairoRegular"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Reaction Pills Row (Under Incoming Bubble) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="End"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F7ECFA, Dark=#39274F}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FCE7F3, Dark=#4E1688}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Incoming Sticker (Partner) - Borderless Floating Sticker (RTL: End = Left) -->
                        <VerticalStackLayout HorizontalOptions="End"
                                             Spacing="3"
                                             IsVisible="{Binding IsIncomingSticker}">
                            <Grid>
                                <VerticalStackLayout Spacing="4">
                                    <!-- Quoted Reply Inset Card for Sticker -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            MaximumWidthRequest="150"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="6">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ReplyToContent}"
                                                   FontFamily="CairoRegular"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <PointerGestureRecognizer PointerPressed="OnMessageBubblePointerPressed"
                                                                      PointerReleased="OnMessageBubblePointerReleased"
                                                                      PointerExited="OnMessageBubblePointerExited" />
                                            <PanGestureRecognizer PanUpdated="OnMessageBubblePanUpdated" />
                                            <SwipeGestureRecognizer Direction="Left"
                                                                    Threshold="35"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            <SwipeGestureRecognizer Direction="Right"
                                                                    Threshold="35"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                    CommandParameter="{Binding .}" />
                                            <TapGestureRecognizer NumberOfTapsRequired="2"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                  CommandParameter="{Binding .}" />
                                            <TapGestureRecognizer Buttons="Secondary"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="{Binding StickerUrl}"
                                               WidthRequest="150"
                                               HeightRequest="150"
                                               Aspect="AspectFit" />
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="End"
                                                Margin="0,0,4,4"
                                                StrokeThickness="0"
                                                BackgroundColor="#90000000"
                                                Padding="7,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding FormattedTime}"
                                                       FontSize="10"
                                                       TextColor="#F8FAFC" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Reaction Pills Row (Under Incoming Sticker) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="End"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F7ECFA, Dark=#39274F}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FCE7F3, Dark=#4E1688}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>

        <!-- 3. Real-Time Typing Banner -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="16,6"
                IsVisible="{Binding IsPartnerTyping}">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Path Data="{StaticResource IconPen}"
                      Fill="{StaticResource BrandPrimary}"
                      WidthRequest="14"
                      HeightRequest="14"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Label Text="{Binding PartnerTypingText}"
                       FontFamily="CairoBold"
                       FontSize="13"
                       TextColor="{StaticResource BrandPrimary}"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- 4. Floating Quoted Reply Preview Bar (Above Input Box) -->
        <Border Grid.Row="3"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16,8"
                Margin="12,0,12,0"
                IsVisible="{Binding HasReply}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,-2"
                        Radius="6"
                        Opacity="0.4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Blue Vertical Accent Line -->
                <BoxView Grid.Column="0"
                         Color="{StaticResource BrandPrimary}"
                         WidthRequest="4"
                         CornerRadius="2"
                         VerticalOptions="Fill" />

                <!-- Text Context -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Path Data="{StaticResource IconReply}"
                              Fill="{StaticResource BrandPrimary}"
                              WidthRequest="12"
                              HeightRequest="12"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="{Binding ReplyingToMessage.SenderFullName, StringFormat='الرد على: {0}'}"
                               FontFamily="CairoBold"
                               FontSize="12"
                               TextColor="{StaticResource BrandPrimary}"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ReplyingToMessage.Content}"
                           FontFamily="CairoRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </VerticalStackLayout>

                <!-- Cancel Reply Action (Close Icon) -->
                <Border Grid.Column="2"
                        WidthRequest="28"
                        HeightRequest="28"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconClose}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                          WidthRequest="12"
                          HeightRequest="12"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 5. Floating Sleek Message Input Bar (Mockup Style) -->
        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              BackgroundColor="{AppThemeBinding Light={StaticResource ChatCanvasLight}, Dark=#13101A}"
              Padding="14,8,14,14"
              VerticalOptions="Center">

            <!-- Circular '+' Attachment Button -->
            <Border Grid.Column="0"
                    WidthRequest="48"
                    HeightRequest="48"
                    StrokeThickness="{AppThemeBinding Light=1, Dark=0}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252131}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsAttachmentPanelVisible}" Value="True">
                        <Setter Property="BackgroundColor" Value="#8E30F5" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAttachmentPanelCommand}" />
                </Border.GestureRecognizers>
                <Label Text="+"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark=#FFFFFF}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-2,0,0" />
            </Border>

            <!-- Rounded Pill Input + Heart + Emoji + Mic + Circular Violet Send Button -->
            <Border Grid.Column="1"
                    StrokeThickness="{AppThemeBinding Light=1, Dark=0}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=Transparent}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252131}"
                    Padding="14,0,6,0"
                    HeightRequest="48"
                    IsVisible="{Binding IsRecordingVoice, Converter={StaticResource InverseBoolConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4" VerticalOptions="Center">
                    <Entry x:Name="MessageInputEntry"
                           Grid.Column="0"
                           Text="{Binding MessageText, Mode=TwoWay}"
                           Placeholder="اكتب رسالة..."
                           FontFamily="CairoRegular"
                           HorizontalTextAlignment="Start"
                           Focused="OnMessageInputEntryFocused"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark=#8C7FA6}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SendMessageCommand}" />

                    <!-- Send Heart Pulse / Hug Button -->
                    <Border Grid.Column="1"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendHeartPulseCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconHeart}"
                              Fill="{StaticResource BrandNeonPink}"
                              WidthRequest="18"
                              HeightRequest="18"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <!-- Emoji Toggle -->
                    <Border Grid.Column="2"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEmojiPickerVisible}" Value="True">
                                <Setter Property="BackgroundColor" Value="#3A0B6B" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleEmojiPickerCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconSmiley}"
                              Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark=#B69AD8}"
                              WidthRequest="19"
                              HeightRequest="19"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <!-- Voice Mic Button -->
                    <Border Grid.Column="3"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartVoiceRecordingCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconMic}"
                              Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark=#B69AD8}"
                              WidthRequest="18"
                              HeightRequest="18"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <!-- Circular Violet Send Button -->
                    <Border Grid.Column="4"
                            WidthRequest="38"
                            HeightRequest="38"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9B3BF9" Offset="0.0" />
                                <GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="19" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#8E30F5" Offset="0,2" Radius="8" Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconSend}"
                              Fill="#FFFFFF"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>

            <!-- Live Voice Recording Pill -->
            <Border Grid.Column="1"
                    StrokeThickness="1.5"
                    Stroke="{StaticResource BrandNeonPink}"
                    BackgroundColor="{AppThemeBinding Light=#FFF0FA, Dark=#2A0E49}"
                    Padding="12,0,6,0"
                    HeightRequest="48"
                    IsVisible="{Binding IsRecordingVoice}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#EF4444" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding RecordingDurationText, StringFormat='جاري التسجيل... {0}'}"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                           VerticalOptions="Center" />

                    <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="Transparent" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelVoiceRecordingCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconTrash}" Fill="#EF4444" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="3" WidthRequest="38" HeightRequest="38" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StopAndSendVoiceRecordingCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconSend}" Fill="#FFFFFF" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Interactive Stickers & Media Drawer -->
        <Border Grid.Row="5"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16,12,16,16"
                IsVisible="{Binding IsAttachmentPanelVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">
                <!-- Top Drag Handle & Dismiss Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Path Data="{StaticResource IconSparkles}"
                              Fill="{StaticResource BrandNeonPink}"
                              WidthRequest="15"
                              HeightRequest="15"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="الملصقات والوسائط"
                               FontFamily="CairoBold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Top Drag Handle in Middle -->
                    <BoxView Grid.Column="1"
                             WidthRequest="40"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                             HorizontalOptions="Center">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseAttachmentPanelCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Close Button (X) on the Left (RTL: Column 2 = Left) -->
                    <Border Grid.Column="2"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseAttachmentPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconClose}"
                              Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                              WidthRequest="12"
                              HeightRequest="12"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Action Cards Bar: Sticker Studio, Photo -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <!-- Sticker Studio Card -->
                    <Border Grid.Column="0"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="6" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenStickerStudioCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconSparkles}"
                                  Fill="{StaticResource White}"
                                  WidthRequest="15"
                                  HeightRequest="15"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="استيكر"
                                   FontFamily="CairoBold"
                                   FontSize="12"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Send Photo from Gallery -->
                    <Border Grid.Column="1"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickAndSendImageCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconImage}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="15"
                                  HeightRequest="15"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="صورة"
                                   FontFamily="CairoBold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Capture Photo with Camera -->
                    <Border Grid.Column="2"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CaptureAndSendPhotoCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconCamera}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="15"
                                  HeightRequest="15"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="كاميرا"
                                   FontFamily="CairoBold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Label Text="ملصقاتك والاستيكرات السريعة:"
                       FontFamily="CairoBold"
                       FontSize="13"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />

                <!-- Stickers Responsive Wrapping Grid (No Wide Gaps) -->
                <ScrollView HeightRequest="142" Orientation="Vertical">
                    <FlexLayout BindableLayout.ItemsSource="{Binding ActiveStickers}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:StickerClientDto">
                                <Border WidthRequest="76"
                                        HeightRequest="76"
                                        Margin="4"
                                        Padding="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SendStickerCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding FullImageUrl}"
                                           Aspect="AspectFit"
                                           WidthRequest="62"
                                           HeightRequest="62" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- 6B. Luxury Categorized Emoji Picker Drawer (WhatsApp / Telegram Premium Style) -->
        <Border Grid.Row="5"
                ZIndex="30"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#10091F}"
                Padding="16,12,16,14"
                IsVisible="{Binding IsEmojiPickerVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#60000000" Offset="0,-4" Radius="16" Opacity="0.7" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">
                <!-- Header Row: Title + Active Category Badge on Right | Backspace + Close on Left -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Path Data="{StaticResource IconSmiley}"
                              Fill="{StaticResource BrandNeonPink}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="لوحة الإيموجي"
                               FontFamily="CairoBold"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center" />

                        <Border StrokeThickness="1"
                                Stroke="{StaticResource BrandPrimary}"
                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#281A3E}"
                                Padding="10,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="{Binding SelectedEmojiCategory}"
                                   FontFamily="CairoBold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=#FFB5DC}"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <!-- Backspace / Delete Last Emoji Button -->
                        <Border HeightRequest="32"
                                Padding="12,0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#281A3E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackspaceMessageEmojiCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="⌫"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark=#94A3B8}"
                                       VerticalOptions="Center" />
                                <Label Text="مسح"
                                       FontFamily="CairoBold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark=#94A3B8}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Close Emoji Picker Button -->
                        <Border WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#281A3E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseEmojiPickerCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Quick Favorites Bar (1-Tap Popular Emojis) -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                        Padding="10,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="سريع ⚡"
                               FontFamily="CairoBold"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#64748B}"
                               VerticalOptions="Center" />

                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding QuickEmojis}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#10000000, Dark=#18FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#39274F}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=InsertMessageEmojiCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding .}"
                                                   FontSize="19"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Category Filter Pills with Icons & Active Highlight -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="38">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding EmojiCategoryTabs}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:EmojiCategoryTabItem">
                                <Border Padding="14,5"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#281A3E}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                            <Setter Property="Stroke" Value="#F044A5" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SelectEmojiCategoryCommand}"
                                                              CommandParameter="{Binding Key}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Title}"
                                               FontFamily="CairoBold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Dense, Crisp Emoji Cards Grid (Wraps Cleanly Without Any Empty Voids) -->
                <ScrollView HeightRequest="168" Orientation="Vertical">
                    <FlexLayout BindableLayout.ItemsSource="{Binding FilteredEmojis}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        Margin="3"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#39274F}"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#281A3E}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=InsertMessageEmojiCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- 7. Floating Reaction Bar Modal Overlay (iOS / Telegram / WhatsApp Style) -->
        <Grid Grid.Row="0"
              Grid.RowSpan="6"
              ZIndex="1000"
              IsVisible="{Binding IsReactionPickerVisible}"
              BackgroundColor="#50000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseReactionPickerCommand}" />
            </Grid.GestureRecognizers>

            <!-- Floating Capsule Card -->
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    Padding="18,14"
                    Margin="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#30000000, Dark=#B0000000}"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.8" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <!-- Stop tap propagation so tapping inside does not dismiss picker -->
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <!-- Title Bar with Close Button -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="اختر تفاعلاً مع الرسالة"
                               FontFamily="CairoBold"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />

                        <Border Grid.Column="1"
                                WidthRequest="24"
                                HeightRequest="24"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseReactionPickerCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                  WidthRequest="10"
                                  HeightRequest="10"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Reaction Emojis Row: ❤️ 👍 😂 🔥 😮 😢 -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- ❤️ Heart -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="❤️" />
                            </Border.GestureRecognizers>
                            <Label Text="❤️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 👍 Thumbs Up -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="👍" />
                            </Border.GestureRecognizers>
                            <Label Text="👍" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😂 Laugh -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😂" />
                            </Border.GestureRecognizers>
                            <Label Text="😂" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 🔥 Fire -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="🔥" />
                            </Border.GestureRecognizers>
                            <Label Text="🔥" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😮 Wow -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😮" />
                            </Border.GestureRecognizers>
                            <Label Text="😮" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😢 Sad -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😢" />
                            </Border.GestureRecognizers>
                            <Label Text="😢" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Quick Message Actions Bar (Reply & Copy) -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,4,0,0">
                        <Border Padding="14,7"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReplyFromReactionPickerCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Path Data="{StaticResource IconReply}"
                                      Fill="{StaticResource BrandPrimary}"
                                      WidthRequest="13"
                                      HeightRequest="13"
                                      Aspect="Uniform"
                                      VerticalOptions="Center" />
                                <Label Text="رد على الرسالة"
                                       FontFamily="CairoBold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Padding="14,7"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CopyTargetMessageCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Path Data="{StaticResource IconCopy}"
                                      Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                      WidthRequest="13"
                                      HeightRequest="13"
                                      Aspect="Uniform"
                                      VerticalOptions="Center" />
                                <Label Text="نسخ النص"
                                       FontFamily="CairoBold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 11. Premium Chat Customization Sheet (Wallpaper & Bubble Colors) -->
        <Grid Grid.RowSpan="6"
              IsVisible="{Binding IsCustomizeSheetVisible}"
              BackgroundColor="#99090218">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCustomizeSheetCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="End"
                    StrokeThickness="1"
                    Stroke="#4E2682"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}"
                    Padding="20,16,20,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#FF4FB8" Offset="0,-4" Radius="24" Opacity="0.35" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <BoxView WidthRequest="44"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource Gray300}, Dark=#4E2682}"
                             HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconPalette}"
                                  Fill="{StaticResource BrandNeonPink}"
                                  WidthRequest="18"
                                  HeightRequest="18"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="تخصيص الشات"
                                   FontFamily="CairoBold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="استعادة الافتراضي"
                               FontFamily="CairoBold"
                               FontSize="12"
                               TextColor="{StaticResource BrandNeonPink}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResetChatCustomizationCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Wallpapers Section -->
                    <Label Text="خلفية المحادثة"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#C5AFE4}" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Default Dark -->
                        <Border Grid.Row="0" Grid.Column="0" HeightRequest="54" StrokeThickness="1.5" Stroke="#4E2682" BackgroundColor="#13101A">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedWallpaperKey}" Value="default">
                                    <Setter Property="Stroke" Value="#FF4FB8" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectWallpaperPresetCommand}" CommandParameter="default" /></Border.GestureRecognizers>
                            <Label Text="داكن" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Cosmic Purple -->
                        <Border Grid.Row="0" Grid.Column="1" HeightRequest="54" StrokeThickness="1.5" Stroke="#7B2DF3">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#14042B" Offset="0.0" />
                                    <GradientStop Color="#2E0854" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedWallpaperKey}" Value="cosmic">
                                    <Setter Property="Stroke" Value="#FF4FB8" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectWallpaperPresetCommand}" CommandParameter="cosmic" /></Border.GestureRecognizers>
                            <Label Text="بنفسجي" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Rose Glow -->
                        <Border Grid.Row="0" Grid.Column="2" HeightRequest="54" StrokeThickness="1.5" Stroke="#9D174D">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#280624" Offset="0.0" />
                                    <GradientStop Color="#4A0E3E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedWallpaperKey}" Value="rose">
                                    <Setter Property="Stroke" Value="#FF4FB8" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectWallpaperPresetCommand}" CommandParameter="rose" /></Border.GestureRecognizers>
                            <Label Text="وردي" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Midnight Blue -->
                        <Border Grid.Row="1" Grid.Column="0" HeightRequest="54" StrokeThickness="1.5" Stroke="#3B82F6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0A1128" Offset="0.0" />
                                    <GradientStop Color="#1B2845" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedWallpaperKey}" Value="midnight">
                                    <Setter Property="Stroke" Value="#FF4FB8" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectWallpaperPresetCommand}" CommandParameter="midnight" /></Border.GestureRecognizers>
                            <Label Text="أزرق ليلي" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Pick Custom Image from Gallery (Spans 2 columns so it never clips!) -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="54" StrokeThickness="1.5" Stroke="{StaticResource BrandNeonPink}" BackgroundColor="#2A114E">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedWallpaperKey}" Value="custom">
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                    <Setter Property="BackgroundColor" Value="#3A0B6B" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PickChatWallpaperCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                <Path Data="{StaticResource IconImage}" Fill="#FFD6F2" WidthRequest="17" HeightRequest="17" Aspect="Uniform" VerticalOptions="Center" />
                                <Label Text="اختيار صورة من المعرض" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Bubble Colors Section -->
                    <Label Text="لون فقاعات الرسائل"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#C5AFE4}" />

                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="2" Stroke="#4E2682">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9B3BF9" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBubbleKey}" Value="violet">
                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBubblePresetCommand}" CommandParameter="violet" /></Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                <Path.Triggers><DataTrigger TargetType="Path" Binding="{Binding SelectedBubbleKey}" Value="violet"><Setter Property="IsVisible" Value="True" /></DataTrigger></Path.Triggers>
                            </Path>
                        </Border>

                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="2" Stroke="#4E2682">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#D9268E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBubbleKey}" Value="pink">
                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBubblePresetCommand}" CommandParameter="pink" /></Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                <Path.Triggers><DataTrigger TargetType="Path" Binding="{Binding SelectedBubbleKey}" Value="pink"><Setter Property="IsVisible" Value="True" /></DataTrigger></Path.Triggers>
                            </Path>
                        </Border>

                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="2" Stroke="#4E2682">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0.0" /><GradientStop Color="#1D4ED8" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBubbleKey}" Value="ocean">
                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBubblePresetCommand}" CommandParameter="ocean" /></Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                <Path.Triggers><DataTrigger TargetType="Path" Binding="{Binding SelectedBubbleKey}" Value="ocean"><Setter Property="IsVisible" Value="True" /></DataTrigger></Path.Triggers>
                            </Path>
                        </Border>

                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="2" Stroke="#4E2682">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0.0" /><GradientStop Color="#059669" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBubbleKey}" Value="emerald">
                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBubblePresetCommand}" CommandParameter="emerald" /></Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                <Path.Triggers><DataTrigger TargetType="Path" Binding="{Binding SelectedBubbleKey}" Value="emerald"><Setter Property="IsVisible" Value="True" /></DataTrigger></Path.Triggers>
                            </Path>
                        </Border>

                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="2" Stroke="#4E2682">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0.0" /><GradientStop Color="#D97706" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBubbleKey}" Value="gold">
                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBubblePresetCommand}" CommandParameter="gold" /></Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                                <Path.Triggers><DataTrigger TargetType="Path" Binding="{Binding SelectedBubbleKey}" Value="gold"><Setter Property="IsVisible" Value="True" /></DataTrigger></Path.Triggers>
                            </Path>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Done Button -->
                    <Border HeightRequest="44" StrokeThickness="0" Margin="0,4,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4FB8" Offset="0.0" />
                                <GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseCustomizeSheetCommand}" /></Border.GestureRecognizers>
                        <Label Text="تم" FontFamily="CairoBold" FontSize="14" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Floating Heart Pulse Animation Layer -->
        <Grid x:Name="HeartOverlayGrid"
              Grid.RowSpan="6"
              InputTransparent="True" />

    </Grid>
</ContentPage>
