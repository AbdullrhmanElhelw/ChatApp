<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark Theme Dynamic Tokens (WhatsApp Dark Luxury Palette) -->
    <Color x:Key="ThemeBackground">#0B141B</Color>
    <Color x:Key="ThemeChatBackground">#0B141B</Color>
    <Color x:Key="ThemeHeaderBackground">#1F2C34</Color>
    <Color x:Key="ThemeSurfaceCard">#111B21</Color>
    <Color x:Key="ThemeSurfaceElevated">#202C33</Color>
    <Color x:Key="ThemeBorder">#222D34</Color>
    <Color x:Key="ThemeDivider">#222D34</Color>
    <Color x:Key="ThemeSearchBarBackground">#202C33</Color>

    <!-- Text Colors -->
    <Color x:Key="ThemeTextPrimary">#E9EDEF</Color>
    <Color x:Key="ThemeTextSecondary">#8696A0</Color>
    <Color x:Key="ThemeTextMuted">#667781</Color>
    <Color x:Key="ThemeTextPlaceholder">#667781</Color>

    <!-- Message Bubbles -->
    <Color x:Key="ThemeBubbleOutgoing">#005C4B</Color>
    <Color x:Key="ThemeBubbleIncoming">#202C33</Color>
    <Color x:Key="ThemeTextOutgoing">#E9EDEF</Color>
    <Color x:Key="ThemeTextIncoming">#E9EDEF</Color>
    <Color x:Key="ThemeTimeOutgoing">#8696A0</Color>
    <Color x:Key="ThemeTimeIncoming">#8696A0</Color>
    <Color x:Key="ThemeTicksRead">#53BDEB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackground}" />
    <SolidColorBrush x:Key="ThemeSurfaceCardBrush" Color="{StaticResource ThemeSurfaceCard}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
</ResourceDictionary>
