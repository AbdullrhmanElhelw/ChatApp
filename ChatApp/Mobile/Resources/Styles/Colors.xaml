<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BetweenUs Design System v1.0 — Brand Identity Palette (Deep Purple + Violet + Pink) -->
    <Color x:Key="DeepPurple">#180B35</Color>
    <Color x:Key="BrandPrimary">#7025B8</Color>
    <Color x:Key="BrandPrimaryLight">#9B4DDB</Color>
    <Color x:Key="BrandPrimaryDark">#4E1688</Color>
    <Color x:Key="BrandSecondary">#F044A5</Color>
    <Color x:Key="BrandAccent">#F044A5</Color>
    <Color x:Key="SoftPink">#FFB5DC</Color>
    <Color x:Key="OffWhite">#FFF5FF</Color>

    <!-- BetweenUs Dark Theme Core Tokens (Cosmic Purple + Neon Pink) -->
    <Color x:Key="DarkBackground">#1A0035</Color>
    <Color x:Key="DarkSurface">#220E3F</Color>
    <Color x:Key="DarkElevated">#3A0B6B</Color>
    <Color x:Key="DarkBorder">#4B2082</Color>
    <Color x:Key="BrandNeonPink">#FF4FB8</Color>
    <Color x:Key="BrandNeonViolet">#7B2DF3</Color>
    <Color x:Key="BrandBlush">#FFD6F2</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="StatusOnline">#10B981</Color>
    <Color x:Key="StatusOffline">#9B86B8</Color>
    <Color x:Key="StatusSuccess">#10B981</Color>
    <Color x:Key="StatusWarning">#F59E0B</Color>
    <Color x:Key="StatusError">#EF4444</Color>
    <Color x:Key="StatusInfo">#9B4DDB</Color>

    <!-- Neutral Scale (Purple-Tinted Tailored Palette for Light & Dark Modes) -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#FFF5FF</Color>
    <Color x:Key="Gray100">#F7ECFA</Color>
    <Color x:Key="Gray200">#E9D7F5</Color>
    <Color x:Key="Gray300">#D1B8E8</Color>
    <Color x:Key="Gray400">#9B86B8</Color>
    <Color x:Key="Gray500">#755E96</Color>
    <Color x:Key="Gray600">#5A4478</Color>
    <Color x:Key="Gray700">#39274F</Color>
    <Color x:Key="Gray800">#281A3E</Color>
    <Color x:Key="Gray900">#1C1230</Color>
    <Color x:Key="Gray950">#10091F</Color>

    <!-- Message Bubble & Chat Canvas Specific -->
    <Color x:Key="BubbleOutgoingLight">#7025B8</Color>
    <Color x:Key="BubbleOutgoingDark">#7025B8</Color>
    <Color x:Key="BubbleIncomingLight">#FFFFFF</Color>
    <Color x:Key="BubbleIncomingDark">#1C1230</Color>
    <Color x:Key="ChatCanvasLight">#FFF5FF</Color>
    <Color x:Key="ChatCanvasDark">#10091F</Color>
    <Color x:Key="ChatHeaderLight">#FFFFFF</Color>
    <Color x:Key="ChatHeaderDark">#1C1230</Color>
    <Color x:Key="BlueTicks">#FFB5DC</Color>

    <!-- Common Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondary}" />
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnline}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <!-- Compatibility Aliases for Standard MAUI Template Controls -->
    <Color x:Key="Primary">#7025B8</Color>
    <Color x:Key="Secondary">#F044A5</Color>
    <Color x:Key="Tertiary">#9B4DDB</Color>
    <Color x:Key="PrimaryDark">#9B4DDB</Color>
    <Color x:Key="PrimaryDarkText">#FFF5FF</Color>
    <Color x:Key="SecondaryDarkText">#FFB5DC</Color>
    <Color x:Key="TertiaryDarkText">#9B86B8</Color>
    <Color x:Key="MidnightBlue">#180B35</Color>
    <Color x:Key="OffBlack">#10091F</Color>
    <Color x:Key="Magenta">#F044A5</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />

    <!-- BetweenUs Gradient Brushes -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7025B8" Offset="0.0" />
        <GradientStop Color="#F044A5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradientDarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#180B35" Offset="0.0" />
        <GradientStop Color="#7025B8" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
