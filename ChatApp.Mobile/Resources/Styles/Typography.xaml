<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing Scale -->
    <x:Double x:Key="SpacingMicro">2</x:Double>
    <x:Double x:Key="SpacingTiny">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>
    <x:Double x:Key="SpacingXXLarge">48</x:Double>

    <!-- Corner Radius Scale -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">14</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">22</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    
    <x:Double x:Key="DoubleRadiusSmall">8</x:Double>
    <x:Double x:Key="DoubleRadiusMedium">14</x:Double>
    <x:Double x:Key="DoubleRadiusLarge">22</x:Double>
    <x:Double x:Key="DoubleRadiusPill">999</x:Double>

    <!-- Typography Text Styles -->
    <Style x:Key="TypographyH1" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style x:Key="TypographyH2" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style x:Key="TypographyH3" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="TypographySubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style x:Key="TypographyBody" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <Style x:Key="TypographyBodyBold" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <Style x:Key="TypographyCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="TypographyTiny" TargetType="Label">
        <Setter Property="FontFamily" Value="CairoRegular" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>
</ResourceDictionary>
