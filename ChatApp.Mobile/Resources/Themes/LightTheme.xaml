<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Theme Dynamic Tokens (WhatsApp Warm Canvas Palette) -->
    <Color x:Key="ThemeBackground">#FFFFFF</Color>
    <Color x:Key="ThemeChatBackground">#EFEAE2</Color>
    <Color x:Key="ThemeHeaderBackground">#F0F2F5</Color>
    <Color x:Key="ThemeSurfaceCard">#FFFFFF</Color>
    <Color x:Key="ThemeSurfaceElevated">#FFFFFF</Color>
    <Color x:Key="ThemeBorder">#E9EDEF</Color>
    <Color x:Key="ThemeDivider">#E9EDEF</Color>
    <Color x:Key="ThemeSearchBarBackground">#F0F2F5</Color>

    <!-- Text Colors -->
    <Color x:Key="ThemeTextPrimary">#111B21</Color>
    <Color x:Key="ThemeTextSecondary">#667781</Color>
    <Color x:Key="ThemeTextMuted">#8696A0</Color>
    <Color x:Key="ThemeTextPlaceholder">#8696A0</Color>

    <!-- Message Bubbles -->
    <Color x:Key="ThemeBubbleOutgoing">#D9FDD3</Color>
    <Color x:Key="ThemeBubbleIncoming">#FFFFFF</Color>
    <Color x:Key="ThemeTextOutgoing">#111B21</Color>
    <Color x:Key="ThemeTextIncoming">#111B21</Color>
    <Color x:Key="ThemeTimeOutgoing">#667781</Color>
    <Color x:Key="ThemeTimeIncoming">#667781</Color>
    <Color x:Key="ThemeTicksRead">#53BDEB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackground}" />
    <SolidColorBrush x:Key="ThemeSurfaceCardBrush" Color="{StaticResource ThemeSurfaceCard}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
</ResourceDictionary>
