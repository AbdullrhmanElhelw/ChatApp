<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Chat.ViewModels"
             xmlns:dto="clr-namespace:ChatApp.Mobile.Features.Chat.DTOs"
             xmlns:converters="clr-namespace:ChatApp.Mobile.Converters"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Chat.Pages.ChatPage"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource ChatCanvasLight}, Dark={StaticResource ChatCanvasDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

        <!-- 1. Header / Top Bar (Premium Telegram / Signal Style) -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatHeaderLight}, Dark={StaticResource ChatHeaderDark}}"
                Padding="14,10">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,2"
                        Radius="6"
                        Opacity="0.7" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button (Vector Icon) -->
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconBack}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Partner Avatar & Online Indicator -->
                <controls:AvatarView Grid.Column="1"
                                     FullName="{Binding ChatTitle}"
                                     AvatarUrl="{Binding AvatarUrl}"
                                     Size="42"
                                     IsOnline="{Binding IsPartnerOnline}" />

                <!-- Partner Info & Status -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding ChatTitle}"
                           FontFamily="CairoBold"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           LineBreakMode="TailTruncation" />

                    <!-- Live Typing Indicator -->
                    <Label Text="{Binding PartnerTypingText}"
                           FontFamily="CairoBold"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandPrimaryLight}"
                           IsVisible="{Binding IsPartnerTyping}" />

                    <!-- Dynamic Presence (Online / Last Seen) -->
                    <Label Text="{Binding PartnerPresenceText}"
                           FontFamily="CairoRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding IsPartnerTyping, Converter={StaticResource InverseBoolConverter}}" />
                </VerticalStackLayout>

                <!-- Actions: Call Placeholders & Connection Status -->
                <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Path Data="{StaticResource IconVideo}"
                              Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Path Data="{StaticResource IconPhone}"
                              Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            Padding="8,4"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ConnectionStatusText}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 2. Message Feed -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                    <!-- E2EE Encryption Pill (Vector Lock Icon) -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            Padding="14,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.4" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconWarning}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="شارك معلوماتك الشخصية فقط مع الأشخاص الذين تثق بهم."
                                   FontFamily="CairoRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ChatMessageItem">
                    <Grid Padding="16,2">
                        <!-- Outgoing Bubble (Mine) - Signal Royal Cobalt Style (RTL: Start = Right) -->
                        <VerticalStackLayout HorizontalOptions="Start"
                                             MaximumWidthRequest="340"
                                             Spacing="3"
                                             IsVisible="{Binding IsOutgoingNormal}">
                            <Border x:Name="OutgoingBubble"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource BrandPrimary}"
                                    Padding="14,9">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18,18,4,18" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="4" Opacity="0.3" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="5">
                                    <!-- Quoted Reply Inset Card -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="#22FFFFFF"
                                            Padding="10,6"
                                            StrokeThickness="0"
                                            Margin="0,0,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                                            <BoxView Grid.Column="0" Color="#FFFFFF" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding DisplayReplySender}"
                                                       FontFamily="CairoBold"
                                                       FontSize="11"
                                                       TextColor="#BFDBFE"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding ReplyToContent}"
                                                       FontFamily="CairoRegular"
                                                       FontSize="11"
                                                       TextColor="#F1F5F9"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Text Message Content -->
                                    <Label Text="{Binding Content}"
                                           FontFamily="CairoRegular"
                                           FontSize="15"
                                           TextColor="{StaticResource White}"
                                           LineBreakMode="WordWrap"
                                           HorizontalTextAlignment="Start"
                                           IsVisible="{Binding IsTextMessage}" />

                                    <!-- Image Attachment Preview -->
                                    <Border StrokeThickness="0"
                                            MaximumWidthRequest="260"
                                            MaximumHeightRequest="260"
                                            IsVisible="{Binding IsImage}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding DisplayImageUrl}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Actions Row: Quick Reaction, Reply, Timestamp & Read Status -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                                        <!-- Quick Reaction Smiley Trigger -->
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconSmiley}"
                                                  Fill="#BFDBFE"
                                                  WidthRequest="13"
                                                  HeightRequest="13"
                                                  Aspect="Uniform"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center" />
                                        </Border>

                                        <!-- Quick Reply Button -->
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconReply}"
                                                  Fill="#BFDBFE"
                                                  WidthRequest="12"
                                                  HeightRequest="12"
                                                  Aspect="Uniform"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center" />
                                        </Border>

                                        <Label Text="{Binding FormattedTime}"
                                               FontFamily="CairoRegular"
                                               FontSize="10"
                                               TextColor="#BFDBFE"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding StatusIcon}"
                                               FontSize="11"
                                               TextColor="#93C5FD"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Reaction Pills Row (Under Outgoing Bubble) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Outgoing Sticker (Mine) - Borderless Floating Sticker (RTL: Start = Right) -->
                        <VerticalStackLayout HorizontalOptions="Start"
                                             Spacing="3"
                                             IsVisible="{Binding IsOutgoingSticker}">
                            <Grid>
                                <VerticalStackLayout Spacing="4">
                                    <!-- Quoted Reply Inset Card for Sticker -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="#22FFFFFF"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            MaximumWidthRequest="150"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="6">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ReplyToContent}"
                                                   FontFamily="CairoRegular"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Image Source="{Binding StickerUrl}"
                                               WidthRequest="150"
                                               HeightRequest="150"
                                               Aspect="AspectFit" />
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="End"
                                                Margin="0,0,4,4"
                                                StrokeThickness="0"
                                                BackgroundColor="#90000000"
                                                Padding="6,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <!-- Quick Reaction Trigger -->
                                                <Border WidthRequest="18"
                                                        HeightRequest="18"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconSmiley}"
                                                          Fill="#F8FAFC"
                                                          WidthRequest="11"
                                                          HeightRequest="11"
                                                          Aspect="Uniform"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                                </Border>

                                                <!-- Quick Reply -->
                                                <Border WidthRequest="18"
                                                        HeightRequest="18"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconReply}"
                                                          Fill="#F8FAFC"
                                                          WidthRequest="10"
                                                          HeightRequest="10"
                                                          Aspect="Uniform"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding FormattedTime}"
                                                       FontSize="10"
                                                       TextColor="#F8FAFC" />
                                                <Label Text="{Binding StatusIcon}"
                                                       FontSize="11"
                                                       TextColor="{Binding StatusColor}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Reaction Pills Row (Under Outgoing Sticker) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Incoming Bubble (Partner) - Slate Surface Style (RTL: End = Left) -->
                        <VerticalStackLayout HorizontalOptions="End"
                                             MaximumWidthRequest="340"
                                             Spacing="3"
                                             IsVisible="{Binding IsIncomingNormal}">
                            <Border x:Name="IncomingBubble"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                    Padding="14,9">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18,18,18,4" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.5" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="5">
                                    <!-- Quoted Reply Inset Card -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                            Padding="10,6"
                                            StrokeThickness="0"
                                            Margin="0,0,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding DisplayReplySender}"
                                                       FontFamily="CairoBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource BrandPrimary}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding ReplyToContent}"
                                                       FontFamily="CairoRegular"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Text Message Content -->
                                    <Label Text="{Binding Content}"
                                           FontFamily="CairoRegular"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           LineBreakMode="WordWrap"
                                           HorizontalTextAlignment="Start"
                                           IsVisible="{Binding IsTextMessage}" />

                                    <!-- Image Attachment Preview -->
                                    <Border StrokeThickness="0"
                                            MaximumWidthRequest="260"
                                            MaximumHeightRequest="260"
                                            IsVisible="{Binding IsImage}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding DisplayImageUrl}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Timestamp and Actions -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                                        <!-- Quick Reaction Trigger -->
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconSmiley}"
                                                  Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                  WidthRequest="13"
                                                  HeightRequest="13"
                                                  Aspect="Uniform"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center" />
                                        </Border>

                                        <!-- Quick Reply Button -->
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Data="{StaticResource IconReply}"
                                                  Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                  WidthRequest="12"
                                                  HeightRequest="12"
                                                  Aspect="Uniform"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center" />
                                        </Border>

                                        <Label Text="{Binding FormattedTime}"
                                               FontFamily="CairoRegular"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Reaction Pills Row (Under Incoming Bubble) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="End"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Incoming Sticker (Partner) - Borderless Floating Sticker (RTL: End = Left) -->
                        <VerticalStackLayout HorizontalOptions="End"
                                             Spacing="3"
                                             IsVisible="{Binding IsIncomingSticker}">
                            <Grid>
                                <VerticalStackLayout Spacing="4">
                                    <!-- Quoted Reply Inset Card for Sticker -->
                                    <Border IsVisible="{Binding HasReplyTo}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                            Padding="8,4"
                                            StrokeThickness="0"
                                            MaximumWidthRequest="150"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="3,*" ColumnSpacing="6">
                                            <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" WidthRequest="3" CornerRadius="1" VerticalOptions="Fill" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ReplyToContent}"
                                                   FontFamily="CairoRegular"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Image Source="{Binding StickerUrl}"
                                               WidthRequest="150"
                                               HeightRequest="150"
                                               Aspect="AspectFit" />
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="End"
                                                Margin="0,0,4,4"
                                                StrokeThickness="0"
                                                BackgroundColor="#90000000"
                                                Padding="6,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <!-- Quick Reaction Trigger -->
                                                <Border WidthRequest="18"
                                                        HeightRequest="18"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenReactionPickerCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconSmiley}"
                                                          Fill="#F8FAFC"
                                                          WidthRequest="11"
                                                          HeightRequest="11"
                                                          Aspect="Uniform"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                                </Border>

                                                <!-- Quick Reply -->
                                                <Border WidthRequest="18"
                                                        HeightRequest="18"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=StartReplyCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconReply}"
                                                          Fill="#F8FAFC"
                                                          WidthRequest="10"
                                                          HeightRequest="10"
                                                          Aspect="Uniform"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding FormattedTime}"
                                                       FontSize="10"
                                                       TextColor="#F8FAFC" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Reaction Pills Row (Under Incoming Sticker) -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Reactions}"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="End"
                                        IsVisible="{Binding HasReactions}"
                                        Margin="4,-2,4,2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ReactionCountClientDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#25000000, Dark=#35FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                Padding="10,4"
                                                Margin="0,0,6,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasReacted}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}" />
                                                    <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleReactionPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding Count}" FontSize="12" FontFamily="CairoBold" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. Real-Time Typing Banner -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="16,6"
                IsVisible="{Binding IsPartnerTyping}">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Path Data="{StaticResource IconPen}"
                      Fill="{StaticResource BrandPrimary}"
                      WidthRequest="14"
                      HeightRequest="14"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Label Text="{Binding PartnerTypingText}"
                       FontFamily="CairoBold"
                       FontSize="13"
                       TextColor="{StaticResource BrandPrimary}"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- 4. Floating Quoted Reply Preview Bar (Above Input Box) -->
        <Border Grid.Row="3"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16,8"
                Margin="12,0,12,0"
                IsVisible="{Binding HasReply}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,-2"
                        Radius="6"
                        Opacity="0.4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Blue Vertical Accent Line -->
                <BoxView Grid.Column="0"
                         Color="{StaticResource BrandPrimary}"
                         WidthRequest="4"
                         CornerRadius="2"
                         VerticalOptions="Fill" />

                <!-- Text Context -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Path Data="{StaticResource IconReply}"
                              Fill="{StaticResource BrandPrimary}"
                              WidthRequest="12"
                              HeightRequest="12"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="{Binding ReplyingToMessage.SenderFullName, StringFormat='الرد على: {0}'}"
                               FontFamily="CairoBold"
                               FontSize="12"
                               TextColor="{StaticResource BrandPrimary}"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ReplyingToMessage.Content}"
                           FontFamily="CairoRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </VerticalStackLayout>

                <!-- Cancel Reply Action (Close Icon) -->
                <Border Grid.Column="2"
                        WidthRequest="28"
                        HeightRequest="28"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconClose}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                          WidthRequest="12"
                          HeightRequest="12"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 5. Floating Luxury Message Input Bar -->
        <Border Grid.Row="4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatHeaderLight}, Dark={StaticResource ChatHeaderDark}}"
                Padding="12,10">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,-2"
                        Radius="8"
                        Opacity="0.7" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Attachment Button (Vector Paperclip - Far Right in RTL) -->
                <Border Grid.Column="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAttachmentPanelVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAttachmentPanelCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconPaperclip}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Emoji Studio Toggle Button (Right in RTL) -->
                <Border Grid.Column="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsEmojiPickerVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleEmojiPickerCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconSmiley}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Text Input Box (Ultra Clean Floating Pill - Right-to-Left Arabic Flow) -->
                <Border Grid.Column="2"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        Padding="16,0"
                        HeightRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Entry x:Name="MessageInputEntry"
                           Text="{Binding MessageText, Mode=TwoWay}"
                           Placeholder="اكتب رسالة..."
                           FontFamily="CairoRegular"
                           HorizontalTextAlignment="Start"
                           Focused="OnMessageInputEntryFocused"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           FontSize="14"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SendMessageCommand}" />
                </Border>

                <!-- Floating Send Button (Vector Modern Paper Plane - Far Left in RTL) -->
                <Border Grid.Column="3"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource BrandPrimary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,3" Radius="8" Opacity="0.45" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconSend}"
                          Fill="{StaticResource White}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Margin="2,0,0,0" />
                </Border>
            </Grid>
        </Border>

        <!-- 6. Interactive Stickers & Media Drawer -->
        <Border Grid.Row="5"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16,12,16,16"
                IsVisible="{Binding IsAttachmentPanelVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">
                <!-- Top Drag Handle & Dismiss Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <!-- Header Title on the Right (RTL: Column 0 = Right) -->
                    <Label Grid.Column="0"
                           Text="الملصقات والوسائط 🎨"
                           FontFamily="CairoBold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                           VerticalOptions="Center" />

                    <!-- Top Drag Handle in Middle -->
                    <BoxView Grid.Column="1"
                             WidthRequest="40"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                             HorizontalOptions="Center">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseAttachmentPanelCommand}" />
                        </BoxView.GestureRecognizers>
                    </BoxView>

                    <!-- Close Button (X) on the Left (RTL: Column 2 = Left) -->
                    <Border Grid.Column="2"
                            WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseAttachmentPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconClose}"
                              Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                              WidthRequest="12"
                              HeightRequest="12"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Action Cards Bar: Sticker Studio, Photo -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Sticker Studio Card (Right in RTL) -->
                    <Border Grid.Column="0"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="6" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenStickerStudioCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconSparkles}"
                                  Fill="{StaticResource White}"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="صانع الاستيكرات (Studio)"
                                   FontFamily="CairoBold"
                                   FontSize="13"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Send Photo Card (Left in RTL) -->
                    <Border Grid.Column="1"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickAndSendImageCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconImage}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="إرسال صورة"
                                   FontFamily="CairoBold"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Label Text="ملصقاتك والاستيكرات السريعة:"
                       FontFamily="CairoBold"
                       FontSize="13"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />

                <!-- Stickers Responsive Wrapping Grid (No Wide Gaps) -->
                <ScrollView HeightRequest="142" Orientation="Vertical">
                    <FlexLayout BindableLayout.ItemsSource="{Binding ActiveStickers}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:StickerClientDto">
                                <Border WidthRequest="76"
                                        HeightRequest="76"
                                        Margin="4"
                                        Padding="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SendStickerCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding FullImageUrl}"
                                           Aspect="AspectFit"
                                           WidthRequest="62"
                                           HeightRequest="62" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- 6B. Luxury Categorized Emoji Picker Drawer (WhatsApp / Telegram Premium Style) -->
        <Border Grid.Row="5"
                ZIndex="30"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#0B1120}"
                Padding="16,12,16,14"
                IsVisible="{Binding IsEmojiPickerVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#60000000" Offset="0,-4" Radius="16" Opacity="0.7" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">
                <!-- Header Row: Title + Active Category Badge on Right | Backspace + Close on Left -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="لوحة الإيموجي ✨"
                               FontFamily="CairoBold"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center" />

                        <Border StrokeThickness="1"
                                Stroke="{StaticResource BrandPrimary}"
                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                                Padding="10,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="{Binding SelectedEmojiCategory}"
                                   FontFamily="CairoBold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=#93C5FD}"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <!-- Backspace / Delete Last Emoji Button -->
                        <Border HeightRequest="32"
                                Padding="12,0"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#162032}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackspaceMessageEmojiCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="⌫"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark=#94A3B8}"
                                       VerticalOptions="Center" />
                                <Label Text="مسح"
                                       FontFamily="CairoBold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark=#94A3B8}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Close Emoji Picker Button -->
                        <Border WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#162032}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseEmojiPickerCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Quick Favorites Bar (1-Tap Popular Emojis) -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                        Padding="10,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="سريع ⚡"
                               FontFamily="CairoBold"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#64748B}"
                               VerticalOptions="Center" />

                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding QuickEmojis}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#10000000, Dark=#18FFFFFF}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#1E293B}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=InsertMessageEmojiCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding .}"
                                                   FontSize="19"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Category Filter Pills with Icons & Active Highlight -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="38">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding EmojiCategoryTabs}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:EmojiCategoryTabItem">
                                <Border Padding="14,5"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#162032}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                                            <Setter Property="Stroke" Value="#60A5FA" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SelectEmojiCategoryCommand}"
                                                              CommandParameter="{Binding Key}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Title}"
                                               FontFamily="CairoBold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Dense, Crisp Emoji Cards Grid (Wraps Cleanly Without Any Empty Voids) -->
                <ScrollView HeightRequest="168" Orientation="Vertical">
                    <FlexLayout BindableLayout.ItemsSource="{Binding FilteredEmojis}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        Margin="3"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#1E293B}"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F32}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=InsertMessageEmojiCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- 7. Floating Reaction Bar Modal Overlay (iOS / Telegram / WhatsApp Style) -->
        <Grid Grid.Row="0"
              Grid.RowSpan="6"
              ZIndex="1000"
              IsVisible="{Binding IsReactionPickerVisible}"
              BackgroundColor="#50000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseReactionPickerCommand}" />
            </Grid.GestureRecognizers>

            <!-- Floating Capsule Card -->
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    Padding="18,14"
                    Margin="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#30000000, Dark=#B0000000}"
                            Offset="0,8"
                            Radius="24"
                            Opacity="0.8" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <!-- Stop tap propagation so tapping inside does not dismiss picker -->
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <!-- Title Bar with Close Button -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="اختر تفاعلاً مع الرسالة"
                               FontFamily="CairoBold"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />

                        <Border Grid.Column="1"
                                WidthRequest="24"
                                HeightRequest="24"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseReactionPickerCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                  WidthRequest="10"
                                  HeightRequest="10"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Reaction Emojis Row: ❤️ 👍 😂 🔥 😮 😢 -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- ❤️ Heart -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="❤️" />
                            </Border.GestureRecognizers>
                            <Label Text="❤️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 👍 Thumbs Up -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="👍" />
                            </Border.GestureRecognizers>
                            <Label Text="👍" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😂 Laugh -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😂" />
                            </Border.GestureRecognizers>
                            <Label Text="😂" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 🔥 Fire -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="🔥" />
                            </Border.GestureRecognizers>
                            <Label Text="🔥" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😮 Wow -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😮" />
                            </Border.GestureRecognizers>
                            <Label Text="😮" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- 😢 Sad -->
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReactWithEmojiCommand}" CommandParameter="😢" />
                            </Border.GestureRecognizers>
                            <Label Text="😢" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
