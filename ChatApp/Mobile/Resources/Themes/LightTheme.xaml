<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Theme Dynamic Tokens (BetweenUs Soft Lavender & Rose Palette) -->
    <Color x:Key="ThemeBackground">#FFF5FF</Color>
    <Color x:Key="ThemeChatBackground">#FFF5FF</Color>
    <Color x:Key="ThemeHeaderBackground">#FFFFFF</Color>
    <Color x:Key="ThemeSurfaceCard">#FFFFFF</Color>
    <Color x:Key="ThemeSurfaceElevated">#F7ECFA</Color>
    <Color x:Key="ThemeBorder">#E9D7F5</Color>
    <Color x:Key="ThemeDivider">#E9D7F5</Color>
    <Color x:Key="ThemeSearchBarBackground">#F7ECFA</Color>

    <!-- Text Colors -->
    <Color x:Key="ThemeTextPrimary">#180B35</Color>
    <Color x:Key="ThemeTextSecondary">#5A4478</Color>
    <Color x:Key="ThemeTextMuted">#9B86B8</Color>
    <Color x:Key="ThemeTextPlaceholder">#9B86B8</Color>

    <!-- Message Bubbles -->
    <Color x:Key="ThemeBubbleOutgoing">#7025B8</Color>
    <Color x:Key="ThemeBubbleIncoming">#FFFFFF</Color>
    <Color x:Key="ThemeTextOutgoing">#FFF5FF</Color>
    <Color x:Key="ThemeTextIncoming">#180B35</Color>
    <Color x:Key="ThemeTimeOutgoing">#FFB5DC</Color>
    <Color x:Key="ThemeTimeIncoming">#755E96</Color>
    <Color x:Key="ThemeTicksRead">#F044A5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackground}" />
    <SolidColorBrush x:Key="ThemeSurfaceCardBrush" Color="{StaticResource ThemeSurfaceCard}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
</ResourceDictionary>
