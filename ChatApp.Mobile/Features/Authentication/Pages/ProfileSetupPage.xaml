<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Authentication.ViewModels"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Authentication.Pages.ProfileSetupPage"
             x:DataType="vm:ProfileSetupViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="24" MinimumHeightRequest="650">

            <!-- 1. Header Step Indicator -->
            <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,10,0,24">
                <Label Text="الخطوة الأخيرة: إعداد ملفك الشخصي"
                       Style="{StaticResource TypographyH2}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="أضف لمستك الشخصية ليتمكن أصدقاؤك في BetweenUs من التعرف عليك."
                       Style="{StaticResource TypographyBody}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- 2. Profile Details Form -->
            <VerticalStackLayout Grid.Row="1" Spacing="24" VerticalOptions="Center">

                <!-- Interactive Avatar Section -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Grid WidthRequest="110" HeightRequest="110" HorizontalOptions="Center">
                        <!-- Dynamic Avatar View -->
                        <controls:AvatarView FullName="{Binding DisplayName}"
                                             AvatarUrl="{Binding AvatarUrl}"
                                             Size="100"
                                             IsOnline="True"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />

                        <!-- Camera Action Badge Button -->
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickAvatarCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCamera}"
                                  Fill="{StaticResource White}"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="انقر على أيقونة الكاميرا لتغيير الصورة"
                           Style="{StaticResource TypographyTiny}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Inputs -->
                <VerticalStackLayout Spacing="16">
                    <controls:ChatEntry LabelText="اسم العرض"
                                        Placeholder="اسمك الذي سيظهر للآخرين"
                                        Text="{Binding DisplayName, Mode=TwoWay}" />

                    <!-- Bio Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="النبذة الشخصية (Bio)"
                               FontFamily="CairoBold"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />

                        <Border Style="{StaticResource ChatCardBorder}" Padding="12,8">
                            <Editor Text="{Binding Bio, Mode=TwoWay}"
                                    FontFamily="CairoRegular"
                                    FontSize="14"
                                    AutoSize="TextChanges"
                                    MaximumHeightRequest="100"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                    Placeholder="اكتب نبذة قصيرة عنك..." />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- 3. Bottom Complete Button -->
            <VerticalStackLayout Grid.Row="2" Spacing="12" Margin="0,20,0,10">
                <controls:ChatButton Text="إتمام والبدء في المراسلة"
                                     ButtonType="Primary"
                                     IsLoading="{Binding IsBusy}"
                                     Command="{Binding CompleteSetupCommand}" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
