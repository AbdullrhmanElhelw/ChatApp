<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.CoupleSpace.ViewModels"
             xmlns:models="clr-namespace:ChatApp.Mobile.Features.CoupleSpace.Models"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.CoupleSpace.Pages.CoupleSpacePage"
             x:Name="CoupleRoot"
             x:DataType="vm:CoupleSpaceViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource DarkBackground}}">

    <Grid>
        <!-- Cosmic Gradient Background -->
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFF5FF, Dark=#14042B}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light=#FAF0FC, Dark=#1A0035}" Offset="0.55" />
                    <GradientStop Color="{AppThemeBinding Light=#F3E4FA, Dark=#2E0854}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,Auto,*">
            <!-- 1. Top Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="18,14,18,8" VerticalOptions="Center">
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NavigateBackCommand}" /></Border.GestureRecognizers>
                    <Path Data="{StaticResource IconArrowRight}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark=#FFFFFF}"
                          WidthRequest="18" HeightRequest="18" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Path Data="{StaticResource IconHeart}" Fill="{StaticResource BrandNeonPink}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                    <Label Text="عالمنا الخاص"
                           FontFamily="CairoBold" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="2" FlowDirection="LeftToRight" Spacing="0" VerticalOptions="Center">
                    <Label Text="Between" FontFamily="CairoBold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                    <Label Text="Us" FontFamily="CairoBold" FontSize="13" TextColor="{StaticResource BrandNeonPink}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- 2. Fixed Top Segmented Tabs: مساحتنا | تواريخنا | ذكرياتنا | رسائل حب -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Padding="18,4,18,10">
                <Border Grid.Column="0" HeightRequest="40" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsHomeTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandNeonViolet}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandNeonPink}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:CoupleTab.Home}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconHeart}" Fill="#FFD6F2" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="مساحتنا" FontFamily="CairoBold" FontSize="11" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="1" HeightRequest="40" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDatesTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandNeonViolet}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandNeonPink}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:CoupleTab.Dates}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconCalendar}" Fill="#FFD6F2" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="تواريخنا" FontFamily="CairoBold" FontSize="11" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="2" HeightRequest="40" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMemoriesTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandNeonViolet}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandNeonPink}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:CoupleTab.Memories}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconImage}" Fill="#FFD6F2" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="ذكرياتنا" FontFamily="CairoBold" FontSize="11" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="3" HeightRequest="40" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsLoveNotesTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandNeonViolet}" />
                            <Setter Property="Stroke" Value="{StaticResource BrandNeonPink}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:CoupleTab.LoveNotes}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconMail}" Fill="#FFD6F2" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="رسائل حب" FontFamily="CairoBold" FontSize="11" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- 3. Scrollable Tab Content -->
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="18,4,18,32" Spacing="16">

                    <!-- TAB 0: Home (Pairing + Daily Question) -->
                    <VerticalStackLayout IsVisible="{Binding IsHomeTab}" Spacing="16">

                    <!-- 2a. Couple Pairing Card (Not Paired Yet) -->
                    <Border IsVisible="{Binding IsNotPaired}"
                            StrokeThickness="1"
                            Stroke="#FF4FB8"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}"
                            Padding="18">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#FF4FB8" Offset="0,4" Radius="16" Opacity="0.25" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Path Data="{StaticResource IconHeart}" Fill="{StaticResource BrandNeonPink}" WidthRequest="17" HeightRequest="17" Aspect="Uniform" VerticalOptions="Center" />
                                <Label Text="ربط حسابك بشريكك"
                                       FontFamily="CairoBold" FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="أنشئ كود دعوة خاص بكما أو أدخل كود شريكك لربط عالمكم المشترك."
                                   FontFamily="CairoRegular" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#C5AFE4}"
                                   LineBreakMode="WordWrap" />

                            <!-- Invite Code Display when generated -->
                            <Border IsVisible="{Binding HasInviteCode}"
                                    StrokeThickness="1" Stroke="#7B2DF3"
                                    BackgroundColor="{AppThemeBinding Light=#FFF5FF, Dark=#180930}"
                                    Padding="14,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="كود الدعوة الخاص بك:" FontFamily="CairoRegular" FontSize="11" TextColor="#9B86B8" />
                                        <Label Text="{Binding InviteCode}" FontFamily="CairoBold" FontSize="22" TextColor="{StaticResource BrandNeonPink}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" StrokeThickness="0" Padding="14,8" BackgroundColor="#3A0B6B" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CopyInviteCodeCommand}" /></Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Path Data="{StaticResource IconCopy}" Fill="#FFD6F2" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                            <Label Text="نسخ" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Generate Code Button (Hidden once code is generated) -->
                            <Border IsVisible="{Binding NeedsInviteGeneration}" HeightRequest="44" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CreateInviteCodeCommand}" /></Border.GestureRecognizers>
                                <Label Text="إنشاء كود دعوة" FontFamily="CairoBold" FontSize="13" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Join by Partner Code -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="{AppThemeBinding Light=#FFF5FF, Dark=#180930}" Padding="12,0" HeightRequest="44">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Entry Text="{Binding JoinCodeInput, Mode=TwoWay}"
                                           Placeholder="أدخل كود شريكك (مثال: 7K9P2M)"
                                           FontFamily="CairoRegular" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}"
                                           PlaceholderColor="#8C7FA6"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#3A0B6B" Padding="16,0" HeightRequest="44">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding JoinByCodeCommand}" /></Border.GestureRecognizers>
                                    <Label Text="ربط الآن" FontFamily="CairoBold" FontSize="13" TextColor="#FFD6F2" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Label IsVisible="{Binding HasPairingFeedback}"
                                   Text="{Binding PairingFeedback}"
                                   FontFamily="CairoBold" FontSize="12"
                                   TextColor="{StaticResource BrandNeonPink}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2b. Connected Partner Banner + Hub Menu (When Paired) -->
                    <VerticalStackLayout IsVisible="{Binding IsPaired}" Spacing="14">
                        <Border StrokeThickness="1"
                                Stroke="#FF4FB8"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}"
                                Padding="16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#FF4FB8" Offset="0,4" Radius="16" Opacity="0.28" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <controls:AvatarView Grid.Column="0"
                                                     FullName="{Binding PartnerName}"
                                                     AvatarUrl="{Binding PartnerAvatarUrl}"
                                                     Size="54"
                                                     IsOnline="{Binding IsPartnerOnline}" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Path Data="{StaticResource IconHeart}" Fill="{StaticResource BrandNeonPink}" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="{Binding PartnerName}" FontFamily="CairoBold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding PartnerMood, StringFormat='مزاج شريكك: {0}'}" FontFamily="CairoRegular" FontSize="12" TextColor="{StaticResource BrandNeonPink}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeThickness="1" Stroke="#6B1D4A" BackgroundColor="#3B0D22" Padding="12,6" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding UnlinkCoupleCommand}" /></Border.GestureRecognizers>
                                    <Label Text="فك الربط" FontFamily="CairoBold" FontSize="11" TextColor="#FCA5A5" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Couple Hub Quick Menu (Chat, Memories, Dates, Love Notes) -->
                        <Border StrokeThickness="1" Stroke="#3A1D63" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}" Padding="6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <!-- Row 1: Private Chat -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,12">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPartnerChatCommand}" /></Grid.GestureRecognizers>
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Path Data="{StaticResource IconChat}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="الشات الخاص بيننا" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                                        <Label Text="شاركوا أفكاركم ولحظاتكم فوراً" FontFamily="CairoRegular" FontSize="11" TextColor="#9B86B8" />
                                    </VerticalStackLayout>
                                    <Path Grid.Column="2" Data="{StaticResource IconChevronLeft}" Fill="#9B86B8" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Margin="62,0,12,0" Color="#34185B" />

                                <!-- Row 2: Memories -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,12">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:CoupleTab.Memories}" /></Grid.GestureRecognizers>
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="#3A0B6B">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                        <Path Data="{StaticResource IconImage}" Fill="#FFD6F2" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="ذكرياتنا (Timeline)" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                                        <Label Text="ألبوم صورنا ولحظاتنا الخاصة" FontFamily="CairoRegular" FontSize="11" TextColor="#9B86B8" />
                                    </VerticalStackLayout>
                                    <Path Grid.Column="2" Data="{StaticResource IconChevronLeft}" Fill="#9B86B8" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Daily Question Hero Card -->
                    <Border StrokeThickness="1"
                            Stroke="#5B2699"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#240E45}"
                            Padding="18">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#FF4FB8" Offset="0,4" Radius="16" Opacity="0.22" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconSparkles}" Fill="#FFFFFF" WidthRequest="15" HeightRequest="15" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="سؤال اليوم بينكما"
                                       FontFamily="CairoBold" FontSize="13"
                                       TextColor="{StaticResource BrandNeonPink}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding TodayQuestion}"
                                   FontFamily="CairoBold" FontSize="16" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                                   LineBreakMode="WordWrap" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3D1E6D}"
                                        BackgroundColor="{AppThemeBinding Light=#FFF5FF, Dark=#180930}"
                                        Padding="12,0"
                                        HeightRequest="42">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Entry Text="{Binding TodayAnswer, Mode=TwoWay}"
                                           Placeholder="اكتب إجابتك هنا..."
                                           FontFamily="CairoRegular" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark=#8C7FA6}"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center" />
                                </Border>

                                <Border Grid.Column="1" StrokeThickness="0" Padding="16,0" HeightRequest="42">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SaveDailyAnswerCommand}" /></Border.GestureRecognizers>
                                    <Label Text="حفظ" FontFamily="CairoBold" FontSize="13" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    </VerticalStackLayout>

                    <!-- TAB 1: Special Dates -->
                    <VerticalStackLayout IsVisible="{Binding IsDatesTab}" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="مناسباتنا الخاصة" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" VerticalOptions="Center" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="14,7">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAddDateSheetCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="مناسبة جديدة" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpecialDates}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SpecialDateItem">
                                    <Border StrokeThickness="1" Stroke="#3A1D63" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}" Padding="14">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Path Data="{StaticResource IconCalendar}" Fill="#FFFFFF" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Title}" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                                                <Label Text="{Binding FormattedDate}" FontFamily="CairoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#9B86B8}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#3A0B6B" Padding="10,5" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Label Text="{Binding CountdownBadge}" FontFamily="CairoBold" FontSize="11" TextColor="#FFD6F2" />
                                            </Border>
                                            <Border Grid.Column="3" WidthRequest="32" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent" VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference CoupleRoot}, Path=BindingContext.DeleteSpecialDateCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Path Data="{StaticResource IconTrash}" Fill="#9B86B8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- TAB 2: Our Memories (Albums List -> Tap to open Timeline) -->
                    <VerticalStackLayout IsVisible="{Binding IsMemoriesTab}" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="ألبوم ذكرياتنا" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" VerticalOptions="Center" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="14,7">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAddMemorySheetCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="ذكرى جديدة" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Memories}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MemoryItem">
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference CoupleRoot}, Path=BindingContext.OpenMemoryCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <!-- Cover Thumbnail or Heart Badge -->
                                            <Border Grid.Column="0" WidthRequest="68" HeightRequest="68" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                                <Grid>
                                                    <Path Data="{StaticResource IconHeart}" Fill="#FF4FB8" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Image Source="{Binding CoverImage}" Aspect="AspectFill" IsVisible="{Binding HasImages}" />
                                                </Grid>
                                            </Border>

                                            <!-- Title, Date, Note, Photo Count -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontFamily="CairoBold" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Note}" FontFamily="CairoRegular" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#C5AFE4}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                                    <Label Text="{Binding FormattedDate}" FontFamily="CairoRegular" FontSize="11" TextColor="#9B86B8" VerticalOptions="Center" />
                                                    <Border StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#3A0B6B" Padding="8,2" IsVisible="{Binding HasImages}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <Label Text="{Binding ImageCountBadge}" FontFamily="CairoBold" FontSize="10" TextColor="#FFD6F2" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Actions: Delete + Chevron -->
                                            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0" BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference CoupleRoot}, Path=BindingContext.DeleteMemoryCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconTrash}" Fill="#9B86B8" WidthRequest="15" HeightRequest="15" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Path Data="{StaticResource IconChevronRight}" Fill="#FF4FB8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- TAB 3: Love Notes -->
                    <VerticalStackLayout IsVisible="{Binding IsLoveNotesTab}" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="رسائل الحب المؤجلة" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" VerticalOptions="Center" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="14,7">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAddNoteSheetCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="رسالة حب" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LoveNotes}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LoveNoteItem">
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}" Padding="16">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="#3A0B6B">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                    <Path Data="{StaticResource IconMail}" Fill="#FFD6F2" WidthRequest="17" HeightRequest="17" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Path.Triggers>
                                                            <DataTrigger TargetType="Path" Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconLock}" />
                                                                <Setter Property="Fill" Value="#FF4FB8" />
                                                            </DataTrigger>
                                                        </Path.Triggers>
                                                    </Path>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" FontFamily="CairoBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                                                    <Label Text="{Binding StatusLabel}" FontFamily="CairoRegular" FontSize="11" TextColor="{StaticResource BrandNeonPink}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference CoupleRoot}, Path=BindingContext.DeleteLoveNoteCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="{StaticResource IconTrash}" Fill="#9B86B8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding DisplayPreview}" FontFamily="CairoRegular" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#D5C2F0}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- MEMORY DETAIL TIMELINE OVERLAY (Inside Selected Memory) -->
        <Grid IsVisible="{Binding IsMemoryDetailVisible}" RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#FDF8FF, Dark=#120626}">
            <!-- Detail Top Header -->
            <Grid Grid.Row="0" Padding="18,16,18,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#240D47}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseMemoryDetailCommand}" /></Border.GestureRecognizers>
                    <Path Data="{StaticResource IconArrowLeft}" Fill="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" WidthRequest="17" HeightRequest="17" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding SelectedMemory.Title}" FontFamily="CairoBold" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding SelectedMemory.FormattedDate}" FontFamily="CairoRegular" FontSize="11" TextColor="#B69AD8" />
                </VerticalStackLayout>

                <Border Grid.Column="2" StrokeThickness="0" Padding="12,7" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAddMomentSheetCommand}" /></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="#FFFFFF" WidthRequest="13" HeightRequest="13" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="إضافة لحظة" FontFamily="CairoBold" FontSize="11" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Vertical Timeline Inside Memory -->
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="18,6,18,32" Spacing="16">
                    <!-- Memory Note Banner -->
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}" Padding="14" IsVisible="{Binding SelectedMemory.HasNote}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="{Binding SelectedMemory.Note}" FontFamily="CairoRegular" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#E5D7FA}" LineBreakMode="WordWrap" />
                    </Border>

                    <!-- Timeline Moments (Each Photo = Glowing Heart Node + Card) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedMemory.DisplayMoments}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MemoryMoment">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <!-- Vertical Rail + Glowing Pink Heart Node -->
                                    <Grid Grid.Column="0" WidthRequest="34" RowDefinitions="Auto,*">
                                        <BoxView Grid.Row="0" Grid.RowSpan="2" WidthRequest="2" Color="#4E2682" HorizontalOptions="Center" VerticalOptions="Fill" />
                                        <Border Grid.Row="0" WidthRequest="32" HeightRequest="32" StrokeThickness="1" Stroke="#FFD6F2" VerticalOptions="Start">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Shadow>
                                                <Shadow Brush="#FF4FB8" Offset="0,0" Radius="10" Opacity="0.6" />
                                            </Border.Shadow>
                                            <Path Data="{StaticResource IconHeart}" Fill="#FFFFFF" WidthRequest="15" HeightRequest="15" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Moment Content + Large Photo -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" Padding="0,0,0,22">
                                        <Label Text="{Binding FormattedDate}" FontFamily="CairoRegular" FontSize="12" TextColor="#B69AD8" />
                                        <Label Text="{Binding Title}" FontFamily="CairoBold" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" IsVisible="{Binding HasTitle}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Caption}" FontFamily="CairoRegular" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#E8DCFA}" IsVisible="{Binding HasCaption}" LineBreakMode="WordWrap" />
                                        <Border StrokeThickness="1" Stroke="#4E2682" HeightRequest="200" IsVisible="{Binding HasImage}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference CoupleRoot}, Path=BindingContext.OpenMemoryImagePreviewCommand}" CommandParameter="{Binding DisplayImageUrl}" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <Image Source="{Binding DisplayImageUrl}" Aspect="AspectFill" />
                                                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="#AA240D47" HorizontalOptions="End" VerticalOptions="End" Margin="12">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                                    <Path Data="{StaticResource IconHeart}" Fill="#FF4FB8" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- MODAL 1: Add Special Date -->
        <Grid IsVisible="{Binding IsAddDateSheetVisible}" BackgroundColor="#99090218">
            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAllSheetsCommand}" /></Grid.GestureRecognizers>
            <Border VerticalOptions="End" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}" Padding="20,18,20,28">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <VerticalStackLayout Spacing="14">
                    <Label Text="إضافة مناسبة خاصة" FontFamily="CairoBold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" HorizontalOptions="Center" />
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,0" HeightRequest="48">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding NewDateTitle, Mode=TwoWay}" Placeholder="اسم المناسبة (مثلاً: عيد ميلادنا)" FontFamily="CairoRegular" FontSize="14" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <DatePicker Date="{Binding NewDateValue, Mode=TwoWay}" TextColor="#FFFFFF" FontFamily="CairoRegular" />
                    <Border HeightRequest="48" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SaveSpecialDateCommand}" /></Border.GestureRecognizers>
                        <Label Text="حفظ المناسبة" FontFamily="CairoBold" FontSize="15" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MODAL 2: Add Memory -->
        <Grid IsVisible="{Binding IsAddMemorySheetVisible}" BackgroundColor="#99090218">
            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAllSheetsCommand}" /></Grid.GestureRecognizers>
            <Border VerticalOptions="End" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}" Padding="20,18,20,28">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12">
                    <Label Text="إضافة ذكرى جديدة" FontFamily="CairoBold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" HorizontalOptions="Center" />
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,0" HeightRequest="46">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding NewMemoryTitle, Mode=TwoWay}" Placeholder="عنوان الذكرى" FontFamily="CairoRegular" FontSize="14" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,6" HeightRequest="80">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Editor Text="{Binding NewMemoryNote, Mode=TwoWay}" Placeholder="اكتب تفاصيل الذكرى..." FontFamily="CairoRegular" FontSize="13" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="تاريخ الذكرى:" FontFamily="CairoBold" FontSize="12" TextColor="#C5AFE4" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding NewMemoryDate, Mode=TwoWay}" TextColor="#FFFFFF" FontFamily="CairoRegular" />
                    </Grid>
                    <Border HeightRequest="44" StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#2A114E">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PickMemoryPhotoCommand}" /></Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconImage}" Fill="#FFD6F2" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{Binding SelectedMemoryPhotosLabel}" FontFamily="CairoBold" FontSize="13" TextColor="#FFD6F2" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border HeightRequest="48" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SaveMemoryCommand}" /></Border.GestureRecognizers>
                        <Label Text="حفظ الذكرى" FontFamily="CairoBold" FontSize="15" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MODAL 4: Add Moment to Selected Memory -->
        <Grid IsVisible="{Binding IsAddMomentSheetVisible}" BackgroundColor="#99090218">
            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAllSheetsCommand}" /></Grid.GestureRecognizers>
            <Border VerticalOptions="End" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}" Padding="20,18,20,28">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12">
                    <Label Text="إضافة لحظة جديدة" FontFamily="CairoBold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" HorizontalOptions="Center" />
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,0" HeightRequest="46">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding NewMomentTitle, Mode=TwoWay}" Placeholder="عنوان اللحظة (مثلاً: أول قهوة سوا)" FontFamily="CairoRegular" FontSize="14" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,6" HeightRequest="72">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Editor Text="{Binding NewMomentCaption, Mode=TwoWay}" Placeholder="وصف قصير للحظة (اختياري)..." FontFamily="CairoRegular" FontSize="13" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="التاريخ:" FontFamily="CairoBold" FontSize="11" TextColor="#C5AFE4" />
                            <DatePicker Date="{Binding NewMomentDate, Mode=TwoWay}" TextColor="#FFFFFF" FontFamily="CairoRegular" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="التوقيت:" FontFamily="CairoBold" FontSize="11" TextColor="#C5AFE4" />
                            <TimePicker Time="{Binding NewMomentTime, Mode=TwoWay}" TextColor="#FFFFFF" FontFamily="CairoRegular" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border HeightRequest="44" StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#2A114E">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PickMomentPhotoCommand}" /></Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconImage}" Fill="#FFD6F2" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{Binding SelectedMomentPhotoLabel}" FontFamily="CairoBold" FontSize="13" TextColor="#FFD6F2" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border HeightRequest="48" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SaveMomentCommand}" /></Border.GestureRecognizers>
                        <Label Text="حفظ اللحظة" FontFamily="CairoBold" FontSize="15" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MODAL 3: Add Love Note -->
        <Grid IsVisible="{Binding IsAddNoteSheetVisible}" BackgroundColor="#99090218">
            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseAllSheetsCommand}" /></Grid.GestureRecognizers>
            <Border VerticalOptions="End" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}" Padding="20,18,20,28">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12">
                    <Label Text="كتابة رسالة حب مؤجلة" FontFamily="CairoBold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" HorizontalOptions="Center" />
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,0" HeightRequest="46">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding NewNoteTitle, Mode=TwoWay}" Placeholder="عنوان الرسالة" FontFamily="CairoRegular" FontSize="14" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Border StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#220E3F" Padding="14,6" HeightRequest="90">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Editor Text="{Binding NewNoteMessage, Mode=TwoWay}" Placeholder="اكتب رسالتك من القلب..." FontFamily="CairoRegular" FontSize="13" TextColor="#FFFFFF" PlaceholderColor="#9B86B8" BackgroundColor="Transparent" />
                    </Border>
                    <Label Text="تاريخ فتح الرسالة:" FontFamily="CairoBold" FontSize="12" TextColor="#C5AFE4" />
                    <DatePicker Date="{Binding NewNoteUnlockDate, Mode=TwoWay}" TextColor="#FFFFFF" FontFamily="CairoRegular" />
                    <Border HeightRequest="48" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF4FB8" Offset="0.0" /><GradientStop Color="#7B2DF3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SaveLoveNoteCommand}" /></Border.GestureRecognizers>
                        <Label Text="إغلاق الرسالة وحفظها" FontFamily="CairoBold" FontSize="15" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Full-Screen Memory Image Viewer -->
        <Grid IsVisible="{Binding IsMemoryImageViewerVisible}"
              BackgroundColor="#F2080214"
              Padding="16">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMemoryImagePreviewCommand}" />
            </Grid.GestureRecognizers>
            <Image Source="{Binding PreviewMemoryImageUrl}"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />
            <Border WidthRequest="42"
                    HeightRequest="42"
                    StrokeThickness="1"
                    Stroke="#4E2682"
                    BackgroundColor="#CC240D47"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="6,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMemoryImagePreviewCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconClose}" Fill="#FFFFFF" WidthRequest="16" HeightRequest="16" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
