<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChatApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:ChatApp.Mobile.Features.Authentication.Pages"
    xmlns:conv="clr-namespace:ChatApp.Mobile.Features.Conversations.Pages"
    xmlns:common="clr-namespace:ChatApp.Mobile.Features.Common"
    FlowDirection="RightToLeft"
    FlyoutBehavior="Disabled"
    Title="BetweenUs">

    <ShellContent
        Title="Splash"
        ContentTemplate="{DataTemplate auth:SplashPage}"
        Route="splash" />

    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate auth:WelcomePage}"
        Route="welcome" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate auth:RegisterPage}"
        Route="register" />

    <ShellContent
        Title="Profile Setup"
        ContentTemplate="{DataTemplate auth:ProfileSetupPage}"
        Route="profile-setup" />

    <ShellContent
        Title="Conversations"
        ContentTemplate="{DataTemplate conv:ConversationsPage}"
        Route="conversations" />

    <ShellContent
        Title="Design System"
        ContentTemplate="{DataTemplate common:DesignSystemPage}"
        Route="design-system" />

</Shell>
