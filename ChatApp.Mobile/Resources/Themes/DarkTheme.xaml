<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark Theme Dynamic Tokens -->
    <Color x:Key="ThemeBackground">#0B0F19</Color>
    <Color x:Key="ThemeSurfaceCard">#151D2F</Color>
    <Color x:Key="ThemeSurfaceElevated">#1E293B</Color>
    <Color x:Key="ThemeBorder">#22314E</Color>
    <Color x:Key="ThemeDivider">#1E293B</Color>
    <Color x:Key="ThemeSearchBarBackground">#151D2F</Color>

    <!-- Text Colors -->
    <Color x:Key="ThemeTextPrimary">#F8FAFC</Color>
    <Color x:Key="ThemeTextSecondary">#94A3B8</Color>
    <Color x:Key="ThemeTextMuted">#64748B</Color>
    <Color x:Key="ThemeTextPlaceholder">#64748B</Color>

    <!-- Message Bubbles -->
    <Color x:Key="ThemeBubbleOutgoing">#0F766E</Color>
    <Color x:Key="ThemeBubbleIncoming">#1E293B</Color>
    <Color x:Key="ThemeTextOutgoing">#FFFFFF</Color>
    <Color x:Key="ThemeTextIncoming">#F8FAFC</Color>
    <Color x:Key="ThemeTimeOutgoing">#A7F3D0</Color>
    <Color x:Key="ThemeTimeIncoming">#94A3B8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackground}" />
    <SolidColorBrush x:Key="ThemeSurfaceCardBrush" Color="{StaticResource ThemeSurfaceCard}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
</ResourceDictionary>
