<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Authentication.ViewModels"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Authentication.Pages.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="24" MinimumHeightRequest="700">

            <!-- 1. Top Bar with Back Button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,10,0,16">
                <Button Text="→ رجوع"
                        Command="{Binding NavigateBackCommand}"
                        Style="{StaticResource ChatGhostButton}"
                        FontSize="14"
                        HeightRequest="40"
                        Padding="8,0" />
            </Grid>

            <!-- 2. Form Card Container -->
            <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center">

                <!-- Header -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="إنشاء حساب جديد ✨"
                           Style="{StaticResource TypographyH1}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Text="انضم إلى ChatApp واستمتع بمراسلة فورية وآمنة مع صانع ملصقاتك المفضل."
                           Style="{StaticResource TypographyBody}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!-- Global Error Banner -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#FEF2F2"
                        Stroke="#FCA5A5"
                        StrokeThickness="1"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               FontFamily="CairoRegular"
                               FontSize="13"
                               TextColor="#B91C1C"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Inputs Form -->
                <VerticalStackLayout Spacing="14">
                    <controls:ChatEntry LabelText="الاسم الكامل"
                                        Placeholder="مثال: أحمد محمد"
                                        Text="{Binding FullName, Mode=TwoWay}"
                                        ErrorMessage="{Binding FullNameError}" />

                    <controls:ChatEntry LabelText="اسم المستخدم (Unique Handle)"
                                        Placeholder="ahmed_mohamed"
                                        Text="{Binding UserName, Mode=TwoWay}"
                                        ErrorMessage="{Binding UserNameError}" />

                    <controls:ChatEntry LabelText="البريد الإلكتروني"
                                        Placeholder="ahmed@example.com"
                                        Text="{Binding Email, Mode=TwoWay}"
                                        ErrorMessage="{Binding EmailError}" />

                    <controls:ChatEntry LabelText="كلمة المرور"
                                        Placeholder="••••••••"
                                        Text="{Binding Password, Mode=TwoWay}"
                                        IsPassword="True"
                                        ErrorMessage="{Binding PasswordError}" />

                    <controls:ChatEntry LabelText="تأكيد كلمة المرور"
                                        Placeholder="••••••••"
                                        Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                        IsPassword="True"
                                        ErrorMessage="{Binding ConfirmPasswordError}" />

                    <Label Text="💡 نصيحة: يجب أن تحتوي كلمة المرور على 6 خانات تشمل حرفاً كبيراً ورقم ورمزاً."
                           Style="{StaticResource TypographyTiny}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!-- Submit Button -->
                <controls:ChatButton Text="إنشاء الحساب والمتابعة"
                                     ButtonType="Primary"
                                     IsLoading="{Binding IsBusy}"
                                     Command="{Binding RegisterCommand}"
                                     Margin="0,10,0,0" />

            </VerticalStackLayout>

            <!-- 3. Bottom Link to Login -->
            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="6"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,10">
                <Label Text="لديك حساب بالفعل؟"
                       Style="{StaticResource TypographyBody}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       VerticalOptions="Center" />

                <Button Text="تسجيل الدخول"
                        Command="{Binding NavigateToLoginCommand}"
                        Style="{StaticResource ChatGhostButton}"
                        Padding="4,0"
                        HeightRequest="36"
                        FontFamily="CairoBold" />
            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
