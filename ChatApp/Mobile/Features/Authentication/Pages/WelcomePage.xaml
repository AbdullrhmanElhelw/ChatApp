<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Authentication.ViewModels"
             x:Class="ChatApp.Mobile.Features.Authentication.Pages.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource DarkBackground}}">

    <Grid>
        <!-- Cosmic Ambient Gradient Background -->
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFF5FF, Dark=#14042B}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light=#FAF0FC, Dark=#1A0035}" Offset="0.55" />
                    <GradientStop Color="{AppThemeBinding Light=#F3E4FA, Dark=#2E0854}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="24,18,24,20">

            <!-- 1. Centered Wordmark + Theme Toggle -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Grid Grid.Column="0" WidthRequest="38" HeightRequest="38" IsEnabled="False" />

                <HorizontalStackLayout Grid.Column="1"
                                       FlowDirection="LeftToRight"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="0">
                    <Label Text="Between"
                           FontFamily="CairoBold"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" />
                    <Label Text="Us"
                           FontFamily="CairoBold"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandNeonPink}" />
                </HorizontalStackLayout>

                <Border Grid.Column="2"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#3A1D63}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{AppThemeBinding Light={StaticResource IconMoon}, Dark={StaticResource IconSun}}"
                          Fill="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=#FFD6F2}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- 2. Swipeable 3-Slide Onboarding Carousel -->
            <CarouselView Grid.Row="1"
                          ItemsSource="{Binding Slides}"
                          Position="{Binding CurrentSlideIndex, Mode=TwoWay}"
                          IndicatorView="OnboardingIndicator"
                          Loop="False"
                          VerticalOptions="Center">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnboardingSlide">
                        <VerticalStackLayout Spacing="18"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="8,10">

                            <!-- Glowing Artwork Container -->
                            <Border WidthRequest="176"
                                    HeightRequest="176"
                                    StrokeThickness="1.5"
                                    Stroke="#50FF4FB8"
                                    BackgroundColor="#240D47"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="44" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#FF4FB8" Offset="0,6" Radius="28" Opacity="0.45" />
                                </Border.Shadow>
                                <Image Source="{Binding ImageSource}"
                                       WidthRequest="174"
                                       HeightRequest="174"
                                       Aspect="AspectFill" />
                            </Border>

                            <!-- Slide Titles -->
                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                <Label Text="{Binding TitleLine1}"
                                       FontFamily="CairoBold"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TitleLine2}"
                                       FontFamily="CairoBold"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandNeonPink}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Divider with Vector Heart -->
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.85">
                                <BoxView WidthRequest="36" HeightRequest="1" Color="#6B3FA0" VerticalOptions="Center" />
                                <Path Data="{StaticResource IconHeartOutline}"
                                      Fill="#FFD6F2"
                                      WidthRequest="16"
                                      HeightRequest="16"
                                      Aspect="Uniform"
                                      VerticalOptions="Center" />
                                <BoxView WidthRequest="36" HeightRequest="1" Color="#6B3FA0" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Subtitle -->
                            <Label Text="{Binding Subtitle}"
                                   FontFamily="CairoRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark=#D5C2F0}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="300"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- 3. Carousel Indicator Dots -->
            <IndicatorView x:Name="OnboardingIndicator"
                           Grid.Row="2"
                           HorizontalOptions="Center"
                           Margin="0,4,0,18"
                           IndicatorColor="#4E2682"
                           SelectedIndicatorColor="#FF4FB8"
                           IndicatorSize="9" />

            <!-- 4. Bottom Action Pills & Heart Emblem -->
            <VerticalStackLayout Grid.Row="3" Spacing="12">
                <!-- Primary Gradient Pill -->
                <Border HeightRequest="52" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#FF4FB8" Offset="0,6" Radius="18" Opacity="0.45" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="ابدأ مساحتكم الآن"
                               FontFamily="CairoBold"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               VerticalOptions="Center" />
                        <Path Data="{StaticResource IconBack}"
                              Fill="#FFFFFF"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Secondary Glassy Outlined Pill -->
                <Border HeightRequest="50"
                        StrokeThickness="1.5"
                        Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=#4E2682}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D0A38}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="لديّ حساب بالفعل"
                           FontFamily="CairoBold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark=#FFFFFF}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Bottom Glowing Heart Emblem -->
                <Border WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="1"
                        Stroke="#50FF4FB8"
                        BackgroundColor="#240D47"
                        HorizontalOptions="Center"
                        Margin="0,4,0,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#FF4FB8" Offset="0,0" Radius="12" Opacity="0.5" />
                    </Border.Shadow>
                    <Path Data="{StaticResource IconHeart}"
                          Fill="#FF4FB8"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

        </Grid>
    </Grid>

</ContentPage>
