<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Chat.ViewModels"
             xmlns:dto="clr-namespace:ChatApp.Mobile.Features.Chat.DTOs"
             xmlns:converters="clr-namespace:ChatApp.Mobile.Converters"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Chat.Pages.ChatPage"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource ChatCanvasLight}, Dark={StaticResource ChatCanvasDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- 1. Header / Top Bar (Premium Telegram / Signal Style) -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatHeaderLight}, Dark={StaticResource ChatHeaderDark}}"
                Padding="14,10">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,2"
                        Radius="6"
                        Opacity="0.7" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button (Vector Icon) -->
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconBack}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Partner Avatar & Online Indicator -->
                <controls:AvatarView Grid.Column="1"
                                     FullName="{Binding ChatTitle}"
                                     AvatarUrl="{Binding AvatarUrl}"
                                     Size="42"
                                     IsOnline="{Binding IsPartnerOnline}" />

                <!-- Partner Info & Status -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding ChatTitle}"
                           FontFamily="CairoBold"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           LineBreakMode="TailTruncation" />

                    <!-- Live Typing Indicator -->
                    <Label Text="{Binding PartnerTypingText}"
                           FontFamily="CairoBold"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandPrimaryLight}"
                           IsVisible="{Binding IsPartnerTyping}" />

                    <!-- Dynamic Presence (Online / Last Seen) -->
                    <Label Text="{Binding PartnerPresenceText}"
                           FontFamily="CairoRegular"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding IsPartnerTyping, Converter={StaticResource InverseBoolConverter}}" />
                </VerticalStackLayout>

                <!-- Actions: Call Placeholders & Connection Status -->
                <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Path Data="{StaticResource IconVideo}"
                              Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Border WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Path Data="{StaticResource IconPhone}"
                              Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            Padding="8,4"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ConnectionStatusText}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 2. Message Feed -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="16,14" Spacing="6" HorizontalOptions="Center">
                    <!-- E2EE Encryption Pill (Vector Lock Icon) -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            Padding="14,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.4" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="{StaticResource IconLock}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="الرسائل والمكالمات مشفرة تماماً بين الطرفين في ChatApp"
                                   FontFamily="CairoRegular"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ChatMessageItem">
                    <Grid Padding="16,2">
                        <!-- Outgoing Bubble (Mine) - Signal Royal Cobalt Style -->
                        <Border x:Name="OutgoingBubble"
                                HorizontalOptions="End"
                                MaximumWidthRequest="340"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                Padding="14,9"
                                IsVisible="{Binding IsOutgoingNormal}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18,18,4,18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="4" Opacity="0.3" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="4">
                                <!-- Text Message Content -->
                                <Label Text="{Binding Content}"
                                       FontFamily="CairoRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource White}"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding IsTextMessage}" />

                                <!-- Image Attachment Preview -->
                                <Border StrokeThickness="0"
                                        MaximumWidthRequest="260"
                                        MaximumHeightRequest="260"
                                        IsVisible="{Binding IsImage}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding DisplayImageUrl}"
                                           Aspect="AspectFill" />
                                </Border>

                                <!-- Timestamp and Read Status -->
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
                                    <Label Text="{Binding FormattedTime}"
                                           FontFamily="CairoRegular"
                                           FontSize="10"
                                           TextColor="#BFDBFE" />
                                    <Label Text="{Binding StatusIcon}"
                                           FontSize="11"
                                           TextColor="#93C5FD" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Outgoing Sticker (Mine) - Borderless Floating Sticker -->
                        <Grid HorizontalOptions="End"
                              IsVisible="{Binding IsOutgoingSticker}">
                            <Image Source="{Binding StickerUrl}"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   Aspect="AspectFit" />
                            <Border HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0,0,4,4"
                                    StrokeThickness="0"
                                    BackgroundColor="#90000000"
                                    Padding="6,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding FormattedTime}"
                                           FontSize="10"
                                           TextColor="#F8FAFC" />
                                    <Label Text="{Binding StatusIcon}"
                                           FontSize="11"
                                           TextColor="{Binding StatusColor}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Incoming Bubble (Partner) - Slate Surface Style -->
                        <Border x:Name="IncomingBubble"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="340"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                Padding="14,9"
                                IsVisible="{Binding IsIncomingNormal}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18,18,18,4" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#08000000" Offset="0,1" Radius="3" Opacity="0.5" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="4">
                                <!-- Text Message Content -->
                                <Label Text="{Binding Content}"
                                       FontFamily="CairoRegular"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding IsTextMessage}" />

                                <!-- Image Attachment Preview -->
                                <Border StrokeThickness="0"
                                        MaximumWidthRequest="260"
                                        MaximumHeightRequest="260"
                                        IsVisible="{Binding IsImage}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding DisplayImageUrl}"
                                           Aspect="AspectFill" />
                                </Border>

                                <Label Text="{Binding FormattedTime}"
                                       FontFamily="CairoRegular"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Incoming Sticker (Partner) - Borderless Floating Sticker -->
                        <Grid HorizontalOptions="Start"
                              IsVisible="{Binding IsIncomingSticker}">
                            <Image Source="{Binding StickerUrl}"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   Aspect="AspectFit" />
                            <Border HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0,0,4,4"
                                    StrokeThickness="0"
                                    BackgroundColor="#90000000"
                                    Padding="6,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding FormattedTime}"
                                       FontSize="10"
                                       TextColor="#F8FAFC" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. Real-Time Typing Banner -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="16,6"
                IsVisible="{Binding IsPartnerTyping}">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Path Data="{StaticResource IconPen}"
                      Fill="{StaticResource BrandPrimary}"
                      WidthRequest="14"
                      HeightRequest="14"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Label Text="{Binding PartnerTypingText}"
                       FontFamily="CairoBold"
                       FontSize="13"
                       TextColor="{StaticResource BrandPrimary}"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- 4. Floating Luxury Message Input Bar -->
        <Border Grid.Row="3"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatHeaderLight}, Dark={StaticResource ChatHeaderDark}}"
                Padding="12,10">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#08000000, Dark=#40000000}"
                        Offset="0,-2"
                        Radius="8"
                        Opacity="0.7" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Attachment Button (Vector Paperclip) -->
                <Border Grid.Column="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAttachmentPanelCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconPaperclip}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Stickers Drawer Quick Button (Vector Smiley/Sticker) -->
                <Border Grid.Column="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAttachmentPanelCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconSticker}"
                          Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Text Input Box (Ultra Clean Floating Pill) -->
                <Border Grid.Column="2"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        Padding="16,0"
                        HeightRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding MessageText, Mode=TwoWay}"
                           Placeholder="اكتب رسالة..."
                           FontFamily="CairoRegular"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           FontSize="14"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SendMessageCommand}" />
                </Border>

                <!-- Floating Send Button (Vector Modern Paper Plane) -->
                <Border Grid.Column="3"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource BrandPrimary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,3" Radius="8" Opacity="0.45" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconSend}"
                          Fill="{StaticResource White}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Margin="2,0,0,0" />
                </Border>
            </Grid>
        </Border>

        <!-- 5. Interactive Stickers & Media Drawer -->
        <Border Grid.Row="4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16,12,16,16"
                IsVisible="{Binding IsAttachmentPanelVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="14">
                <!-- Top Drag Handle -->
                <BoxView WidthRequest="40"
                         HeightRequest="4"
                         CornerRadius="2"
                         Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                         HorizontalOptions="Center" />

                <!-- Action Cards Bar: Photo, Sticker Studio -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Send Photo Card -->
                    <Border Grid.Column="0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickAndSendImageCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconImage}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="إرسال صورة"
                                   FontFamily="CairoBold"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Sticker Studio Card -->
                    <Border Grid.Column="1"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="6" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenStickerStudioCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconSparkles}"
                                  Fill="{StaticResource White}"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  VerticalOptions="Center" />
                            <Label Text="صانع الاستيكرات (Studio)"
                                   FontFamily="CairoBold"
                                   FontSize="13"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Label Text="ملصقاتك والاستيكرات السريعة:"
                       FontFamily="CairoBold"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />

                <!-- Stickers Grid / Horizontal Collection -->
                <CollectionView ItemsSource="{Binding ActiveStickers}"
                                HeightRequest="130"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:StickerClientDto">
                            <Border WidthRequest="56"
                                    HeightRequest="56"
                                    Padding="4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=SendStickerCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding FullImageUrl}"
                                       Aspect="AspectFit"
                                       WidthRequest="48"
                                       HeightRequest="48" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
