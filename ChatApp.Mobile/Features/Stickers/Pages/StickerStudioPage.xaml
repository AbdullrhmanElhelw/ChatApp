<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Stickers.ViewModels"
             x:Class="ChatApp.Mobile.Features.Stickers.Pages.StickerStudioPage"
             x:DataType="vm:StickerStudioViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark=#120626}">

    <Grid>
        <!-- Cosmic Ambient Gradient Background -->
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="{AppThemeBinding Light=#FFF5FF, Dark=#14042B}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light=#FAF0FC, Dark=#1A0035}" Offset="0.55" />
                    <GradientStop Color="{AppThemeBinding Light=#F3E4FA, Dark=#2E0854}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*" Padding="16,14,16,0">

            <!-- 1. Top Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,12" VerticalOptions="Center">
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="1"
                        Stroke="#4E2682"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#240D47}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconArrowRight}"
                          Fill="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                          WidthRequest="17" HeightRequest="17" Aspect="Uniform"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                    <Path Data="{StaticResource IconSparkles}"
                          Fill="{StaticResource BrandNeonPink}"
                          WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                    <Label Text="صانع الاستيكرات الذكي"
                           FontFamily="CairoBold" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2" StrokeThickness="0" Padding="14,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#FF4FB8" Offset="0,2" Radius="8" Opacity="0.45" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveStickerCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Path Data="{StaticResource IconSave}" Fill="#FFFFFF" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="حفظ" FontFamily="CairoBold" FontSize="13" TextColor="#FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- 2. Main Studio Scrollable Area -->
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="14" Padding="0,0,0,28" HorizontalOptions="Center" MaximumWidthRequest="500">

                    <!-- Preview Outer Frame -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#4E2682}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B0936}"
                            WidthRequest="316"
                            HeightRequest="316"
                            HorizontalOptions="Center"
                            Padding="10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#7B2DF3" Offset="0,6" Radius="18" Opacity="0.25" />
                        </Border.Shadow>

                        <Grid>
                            <!-- Empty Canvas State -->
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="14"
                                                 IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}">
                                <Border WidthRequest="68" HeightRequest="68" StrokeThickness="0" HorizontalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="{StaticResource IconImage}" Fill="#FFFFFF" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Label Text="اختر صورة لصنع استيكر مخصص"
                                       FontFamily="CairoBold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#E8DCFA}"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                                <Border StrokeThickness="0" Padding="18,10" HorizontalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FF4FB8" Offset="0.0" />
                                            <GradientStop Color="#7B2DF3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Path Data="{StaticResource IconFolder}" Fill="#FFFFFF" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="اختيار صورة من المعرض" FontFamily="CairoBold" FontSize="13" TextColor="#FFFFFF" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Actual Sticker Canvas (Captured as PNG with text, shape & border!) -->
                            <Border x:Name="StickerCanvas"
                                    IsVisible="{Binding HasImage}"
                                    WidthRequest="290"
                                    HeightRequest="290"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent"
                                    Stroke="{Binding CanvasStrokeColor}"
                                    StrokeThickness="{Binding CanvasStrokeThickness}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{Binding CanvasCornerRadius}" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Image Source="{Binding SelectedImagePath}"
                                           Aspect="{Binding ImageAspectMode}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />

                                    <!-- Text Overlay inside Canvas (Rendered directly into final PNG!) -->
                                    <Border VerticalOptions="{Binding CaptionVerticalOptions}"
                                            HorizontalOptions="Center"
                                            Margin="12,16"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding CaptionBackgroundColor}"
                                            Padding="14,5"
                                            IsVisible="{Binding HasCaption}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding CaptionText}"
                                               TextColor="{Binding SelectedColor}"
                                               FontFamily="CairoBold"
                                               FontSize="{Binding CaptionFontSize}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap">
                                            <Label.Shadow>
                                                <Shadow Brush="#000000" Offset="1,2" Radius="4" Opacity="0.85" />
                                            </Label.Shadow>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quick Top Bar below Canvas (Change Photo + Fit Mode) -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" IsVisible="{Binding HasImage}">
                        <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#240D47" Padding="14,7">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PickImageCommand}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Path Data="{StaticResource IconCamera}" Fill="#FFD6F2" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                <Label Text="تغيير الصورة" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#3A0B6B" Padding="14,7">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleImageAspectCommand}" /></Border.GestureRecognizers>
                            <Label Text="{Binding ImageFitLabel}" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Feedback & Error Banners -->
                    <Border StrokeThickness="1" Stroke="#10B981" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" Padding="14,10" IsVisible="{Binding HasStatusMessage}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconCheck}" Fill="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}" FontSize="12" FontFamily="CairoBold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeThickness="1" Stroke="#EF4444" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}" Padding="14,10" IsVisible="{Binding HasError}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconWarning}" Fill="{AppThemeBinding Light=#991B1B, Dark=#FECACA}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}" FontSize="12" FontFamily="CairoBold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 3. Smart Editing Studio Card -->
                    <Border Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#220E3F}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#4E2682}"
                            StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">
                            <!-- Caption Input + Font Size -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Label Text="النص على الاستيكر" FontFamily="CairoBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource DeepPurple}, Dark=#FFFFFF}" VerticalOptions="Center" />
                                <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding DecreaseCaptionSizeCommand}" /></Border.GestureRecognizers>
                                    <Label Text="−" FontSize="18" FontFamily="CairoBold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding IncreaseCaptionSizeCommand}" /></Border.GestureRecognizers>
                                    <Label Text="+" FontSize="18" FontFamily="CairoBold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="{AppThemeBinding Light=#FAF5FF, Dark=#180930}" Padding="14,0" HeightRequest="44">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                    <Entry Text="{Binding CaptionText, Mode=TwoWay}"
                                           Placeholder="اكتب كلمة أو جملة تظهر على الاستيكر..."
                                           FontFamily="CairoRegular" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=#FFFFFF}"
                                           PlaceholderColor="#8C7FA6"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeThickness="1" Stroke="#3D1E6D" BackgroundColor="#2F1359" IsVisible="{Binding HasCaption}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ClearCaptionCommand}" /></Border.GestureRecognizers>
                                    <Path Data="{StaticResource IconClose}" Fill="#FFD6F2" WidthRequest="14" HeightRequest="14" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Smart Quick Captions -->
                            <Label Text="جمل ذكية جاهزة" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="بحبك ❤️" /></Border.GestureRecognizers>
                                        <Label Text="بحبك ❤️" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="وحشتني 🥺" /></Border.GestureRecognizers>
                                        <Label Text="وحشتني 🥺" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="ضحكتني 😂" /></Border.GestureRecognizers>
                                        <Label Text="ضحكتني 😂" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="يلا بينا 🚀" /></Border.GestureRecognizers>
                                        <Label Text="يلا بينا 🚀" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="موافق 💯" /></Border.GestureRecognizers>
                                        <Label Text="موافق 💯" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ApplySmartCaptionCommand}" CommandParameter="أنا هنا 🥰" /></Border.GestureRecognizers>
                                        <Label Text="أنا هنا 🥰" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- Shape & Frame Controls -->
                            <Label Text="الشكل والإطار" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectShapeCommand}" CommandParameter="rounded" /></Border.GestureRecognizers>
                                        <Label Text="مربع ناعم" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectShapeCommand}" CommandParameter="circle" /></Border.GestureRecognizers>
                                        <Label Text="دائري" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#FFFFFF" BackgroundColor="#2F1359" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBorderStyleCommand}" CommandParameter="white" /></Border.GestureRecognizers>
                                        <Label Text="إطار أبيض" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#3A0B6B" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBorderStyleCommand}" CommandParameter="neon" /></Border.GestureRecognizers>
                                        <Label Text="إطار نيون" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectBorderStyleCommand}" CommandParameter="none" /></Border.GestureRecognizers>
                                        <Label Text="بدون إطار" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                                    </Border>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- Text Position & Style -->
                            <Label Text="موضع وشكل النص" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextPositionCommand}" CommandParameter="top" /></Border.GestureRecognizers>
                                        <Label Text="أعلى" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextPositionCommand}" CommandParameter="center" /></Border.GestureRecognizers>
                                        <Label Text="الوسط" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#1B0936" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextPositionCommand}" CommandParameter="bottom" /></Border.GestureRecognizers>
                                        <Label Text="أسفل" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>

                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="#14042B" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextStyleCommand}" CommandParameter="dark" /></Border.GestureRecognizers>
                                        <Label Text="خلفية داكنة" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#FF4FB8" BackgroundColor="#FF4FB8" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextStyleCommand}" CommandParameter="neon" /></Border.GestureRecognizers>
                                        <Label Text="شريط وردي" FontFamily="CairoBold" FontSize="12" TextColor="#FFFFFF" />
                                    </Border>
                                    <Border StrokeThickness="1" Stroke="#4E2682" BackgroundColor="Transparent" Padding="12,6">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectTextStyleCommand}" CommandParameter="outline" /></Border.GestureRecognizers>
                                        <Label Text="نص حر (بدون خلفية)" FontFamily="CairoBold" FontSize="12" TextColor="#FFD6F2" />
                                    </Border>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- Text Colors -->
                            <Label Text="لون النص" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="10">
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#FFFFFF" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#FF4FB8">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#FF4FB8" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#FDE047">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#FDE047" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#60A5FA">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#60A5FA" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#34D399">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#34D399" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#4E2682" BackgroundColor="#F87171">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#F87171" /></Border.GestureRecognizers>
                                    </Border>
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="#FFFFFF" BackgroundColor="#111827">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectColorCommand}" CommandParameter="#111827" /></Border.GestureRecognizers>
                                    </Border>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- Quick Emojis -->
                            <Label Text="إيموجي سريعة" FontFamily="CairoBold" FontSize="12" TextColor="#B69AD8" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="❤️" Command="{Binding AddQuickEmojiCommand}" CommandParameter="❤️" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="🔥" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🔥" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="😂" Command="{Binding AddQuickEmojiCommand}" CommandParameter="😂" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="🥰" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🥰" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="🥺" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🥺" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="🚀" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🚀" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="😎" Command="{Binding AddQuickEmojiCommand}" CommandParameter="😎" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="🎉" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🎉" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                    <Button Text="💯" Command="{Binding AddQuickEmojiCommand}" CommandParameter="💯" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="0" Grid.RowSpan="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource BrandNeonPink}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               WidthRequest="48"
                               HeightRequest="48" />
        </Grid>
    </Grid>
</ContentPage>
