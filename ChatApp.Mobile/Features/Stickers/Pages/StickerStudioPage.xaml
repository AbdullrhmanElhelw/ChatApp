<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Stickers.ViewModels"
             x:Class="ChatApp.Mobile.Features.Stickers.Pages.StickerStudioPage"
             x:DataType="vm:StickerStudioViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16">

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,14" VerticalOptions="Center">
            <!-- Back Button -->
            <Border Grid.Column="0"
                    WidthRequest="38"
                    HeightRequest="38"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconArrowRight}"
                      Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                      WidthRequest="18"
                      HeightRequest="18"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Page Title -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" Margin="12,0,0,0">
                <Path Data="{StaticResource IconSparkles}"
                      Fill="{StaticResource BrandPrimary}"
                      WidthRequest="18"
                      HeightRequest="18"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Label Text="صانع الاستيكرات (Studio)"
                       FontFamily="CairoBold"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Save Action Button -->
            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeThickness="0"
                    Padding="16,9">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,2" Radius="6" Opacity="0.35" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveStickerCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Path Data="{StaticResource IconSave}"
                          Fill="{StaticResource White}"
                          WidthRequest="15"
                          HeightRequest="15"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                    <Label Text="حفظ الاستيكر"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 2. Main Studio Canvas / Preview -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center" MaximumWidthRequest="500">

                <!-- Preview Box -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        WidthRequest="320"
                        HeightRequest="320"
                        HorizontalOptions="Center"
                        Padding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Grid>
                        <!-- Empty Canvas State -->
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="14"
                                             IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}">
                            <Border WidthRequest="64"
                                    HeightRequest="64"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="32" />
                                </Border.StrokeShape>
                                <Path Data="{StaticResource IconImage}"
                                      Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                      WidthRequest="28"
                                      HeightRequest="28"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>

                            <Label Text="اختر صورة للبدء في صنع استيكرك الخاص"
                                   FontFamily="CairoBold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Padding="18,10"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconFolder}"
                                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                          WidthRequest="16"
                                          HeightRequest="16"
                                          Aspect="Uniform"
                                          VerticalOptions="Center" />
                                    <Label Text="اختيار صورة من المعرض"
                                           FontFamily="CairoBold"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Selected Image Canvas -->
                        <Image Source="{Binding SelectedImagePath}"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               IsVisible="{Binding HasImage}" />

                        <!-- Text Overlay Preview -->
                        <Border VerticalOptions="End"
                                HorizontalOptions="Center"
                                Margin="0,0,0,16"
                                BackgroundColor="#90000000"
                                Padding="12,4"
                                IsVisible="{Binding HasCaption}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding CaptionText}"
                                   TextColor="{Binding SelectedColor}"
                                   FontFamily="CairoBold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Feedback Banner -->
                <Border StrokeThickness="1"
                        Stroke="#10B981"
                        BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                        Padding="14,10"
                        IsVisible="{Binding HasStatusMessage}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconCheck}"
                              Fill="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}"
                               FontSize="13"
                               FontFamily="CairoBold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Error Banner -->
                <Border StrokeThickness="1"
                        Stroke="#EF4444"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Padding="14,10"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Path Data="{StaticResource IconWarning}"
                              Fill="{AppThemeBinding Light=#991B1B, Dark=#FECACA}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}"
                               FontSize="13"
                               FontFamily="CairoBold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- 3. Editing Tools -->
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Label Text="إضافة تعليق نصي على الاستيكر"
                               FontFamily="CairoBold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />

                        <!-- Text Input Pill Container -->
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                Padding="16,0"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding CaptionText, Mode=TwoWay}"
                                   Placeholder="اكتب كلمة أو جملة مضحكة..."
                                   FontFamily="CairoRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Quick Emojis -->
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="🔥" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🔥" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                            <Button Text="😂" Command="{Binding AddQuickEmojiCommand}" CommandParameter="😂" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                            <Button Text="❤️" Command="{Binding AddQuickEmojiCommand}" CommandParameter="❤️" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                            <Button Text="🚀" Command="{Binding AddQuickEmojiCommand}" CommandParameter="🚀" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                            <Button Text="😎" Command="{Binding AddQuickEmojiCommand}" CommandParameter="😎" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                            <Button Text="💡" Command="{Binding AddQuickEmojiCommand}" CommandParameter="💡" Style="{StaticResource ChatGhostButton}" WidthRequest="38" HeightRequest="38" Padding="0" />
                        </HorizontalStackLayout>

                        <!-- Change Image Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Padding="16,8"
                                HorizontalOptions="Center"
                                IsVisible="{Binding HasImage}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Path Data="{StaticResource IconCamera}"
                                      Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                                      WidthRequest="15"
                                      HeightRequest="15"
                                      Aspect="Uniform"
                                      VerticalOptions="Center" />
                                <Label Text="تغيير الصورة"
                                       FontFamily="CairoBold"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource BrandPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="48"
                           HeightRequest="48" />

    </Grid>

</ContentPage>
