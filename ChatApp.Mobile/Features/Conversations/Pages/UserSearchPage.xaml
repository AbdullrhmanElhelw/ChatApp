<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Conversations.ViewModels"
             xmlns:authDtos="clr-namespace:ChatApp.Mobile.Features.Authentication.DTOs"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             xmlns:converters="clr-namespace:ChatApp.Mobile.Converters"
             x:Class="ChatApp.Mobile.Features.Conversations.Pages.UserSearchPage"
             x:DataType="vm:UserSearchViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0">

        <!-- 1. Top Bar with Back Button & Title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,4,0,14" VerticalOptions="Center">
            <Border Grid.Column="0"
                    WidthRequest="38"
                    HeightRequest="38"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconBack}"
                      Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                      WidthRequest="18"
                      HeightRequest="18"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="البحث وبدء محادثة جديدة"
                   FontFamily="CairoBold"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />
        </Grid>

        <!-- 2. Search Input Box & Submit Button -->
        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                Padding="16,0,6,0"
                HeightRequest="46"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="23" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Path Grid.Column="0"
                      Data="{StaticResource IconSearch}"
                      Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                      WidthRequest="16"
                      HeightRequest="16"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       Placeholder="ابحث بالاسم الكامل أو اسم المستخدم..."
                       FontFamily="CairoRegular"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       ReturnCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource BrandPrimary}"
                        StrokeThickness="0"
                        Padding="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="بحث"
                           FontFamily="CairoBold"
                           FontSize="13"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Error / Info Banner -->
        <Border Grid.Row="2"
                StrokeThickness="1"
                Stroke="{StaticResource StatusWarning}"
                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                Padding="12,8"
                Margin="0,0,0,12"
                IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Path Data="{StaticResource IconWarning}"
                      Fill="{AppThemeBinding Light=#92400E, Dark=#FDE68A}"
                      WidthRequest="16"
                      HeightRequest="16"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Label Text="{Binding ErrorMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
        </Border>

        <!-- 3. Results Container -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">

            <!-- Section Title -->
            <Label Grid.Row="0"
                   Text="{Binding SectionTitle}"
                   FontFamily="CairoBold"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   Margin="4,0,0,8" />

            <!-- Loading Indicator -->
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="12"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 IsVisible="{Binding IsSearching}">
                <ActivityIndicator IsRunning="{Binding IsSearching}"
                                   Color="{StaticResource BrandPrimary}"
                                   WidthRequest="40"
                                   HeightRequest="40" />
                <Label Text="جاري البحث..."
                       Style="{StaticResource TypographyTiny}"
                       TextColor="{StaticResource BrandPrimary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Results List -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None"
                            IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">

                <!-- Empty Results State -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="14"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="24"
                                         IsVisible="{Binding IsEmpty}">
                        <Border WidthRequest="64"
                                HeightRequest="64"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Path Data="{StaticResource IconSearch}"
                                  Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                  WidthRequest="28"
                                  HeightRequest="28"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                        <Label Text="لم نجد أي مستخدمين بهذا الاسم"
                               Style="{StaticResource TypographyH3}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                               HorizontalOptions="Center" />
                        <Label Text="تأكد من كتابة اسم المستخدم بدقة، أو اختر من المستخدمين المقترحين."
                               Style="{StaticResource TypographyCaption}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- User Result Card -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="authDtos:UserProfileDto">
                        <Border Margin="0,0,0,10"
                                Padding="14,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserSearchViewModel}}, Path=StartConversationCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- User Avatar -->
                                <controls:AvatarView Grid.Column="0"
                                                     FullName="{Binding FullName}"
                                                     AvatarUrl="{Binding AvatarUrl}"
                                                     Size="48"
                                                     IsOnline="{Binding IsOnline}"
                                                     VerticalOptions="Center" />

                                <!-- User Info -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding FullName}"
                                           FontFamily="CairoBold"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />

                                    <Label Text="{Binding UserName, StringFormat='@{0}'}"
                                           FontFamily="CairoRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource BrandPrimary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </VerticalStackLayout>

                                <!-- Message Button Action -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{StaticResource BrandPrimary}"
                                        StrokeThickness="0"
                                        Padding="14,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserSearchViewModel}}, Path=StartConversationCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="مراسلة"
                                           FontFamily="CairoBold"
                                           FontSize="12"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>
