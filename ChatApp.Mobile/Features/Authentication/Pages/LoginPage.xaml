<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Authentication.ViewModels"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Authentication.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="24" MinimumHeightRequest="600">

            <!-- 1. Top Bar with Back Button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,20">
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconArrowRight}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="34"
                            HeightRequest="34"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Image Source="betweenus_logo.png"
                               WidthRequest="34"
                               HeightRequest="34"
                               Aspect="AspectFill" />
                    </Border>
                    <Label Text="BetweenUs"
                           FontFamily="CairoBold"
                           FontSize="17"
                           TextColor="#F044A5"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- 2. Form Card Container -->
            <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center">

                <!-- Header -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="مرحباً بعودتك"
                           Style="{StaticResource TypographyH1}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Text="سجّل دخولك وارجع لمحادثاتك."
                           Style="{StaticResource TypographyBody}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!-- Global Error Banner -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Stroke="#EF4444"
                        StrokeThickness="1"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Path Data="{StaticResource IconWarning}"
                              Fill="{AppThemeBinding Light=#B91C1C, Dark=#FECACA}"
                              WidthRequest="16"
                              HeightRequest="16"
                              Aspect="Uniform"
                              VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               FontFamily="CairoRegular"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FECACA}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Inputs Form -->
                <VerticalStackLayout Spacing="16">
                    <controls:ChatEntry LabelText="اسم المستخدم أو البريد الإلكتروني"
                                        Placeholder="اسم المستخدم أو example@email.com"
                                        Text="{Binding UserNameOrEmail, Mode=TwoWay}"
                                        Keyboard="Email"
                                        ErrorMessage="{Binding UserNameOrEmailError}" />

                    <controls:ChatEntry LabelText="كلمة المرور"
                                        Placeholder="••••••••"
                                        Text="{Binding Password, Mode=TwoWay}"
                                        IsPassword="True"
                                        ErrorMessage="{Binding PasswordError}" />

                    <Button Text="نسيت كلمة المرور؟"
                            Command="{Binding ForgotPasswordCommand}"
                            Style="{StaticResource ChatGhostButton}"
                            HorizontalOptions="End"
                            Padding="4,0"
                            HeightRequest="32"
                            FontSize="13" />
                </VerticalStackLayout>

                <!-- Submit Button -->
                <controls:ChatButton Text="تسجيل الدخول"
                                     ButtonType="Primary"
                                     IsLoading="{Binding IsBusy}"
                                     Command="{Binding LoginCommand}"
                                     Margin="0,10,0,0" />

            </VerticalStackLayout>

            <!-- 3. Bottom Link to Register -->
            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="6"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,10">
                <Label Text="ليس لديك حساب بعد؟"
                       Style="{StaticResource TypographyBody}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       VerticalOptions="Center" />

                <Button Text="إنشاء حساب جديد"
                        Command="{Binding NavigateToRegisterCommand}"
                        Style="{StaticResource ChatGhostButton}"
                        Padding="4,0"
                        HeightRequest="36"
                        FontFamily="CairoBold" />
            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
