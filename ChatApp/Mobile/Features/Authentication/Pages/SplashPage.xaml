<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Authentication.ViewModels"
             x:Class="ChatApp.Mobile.Features.Authentication.Pages.SplashPage"
             x:DataType="vm:SplashViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="#15042C">

    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">

        <!-- Full-Bleed BetweenUs Splash Artwork with Cinematic Ken Burns Zoom -->
        <Image x:Name="SplashArtwork"
               Source="betweenus_splash.png"
               Aspect="AspectFill"
               Opacity="0"
               Scale="1.12"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- Subtle Ambient Breathing Glow Over Centerpiece -->
        <BoxView x:Name="LogoAura"
                 BackgroundColor="#EC4899"
                 Opacity="0.16"
                 CornerRadius="140"
                 WidthRequest="260"
                 HeightRequest="260"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"
                 TranslationY="-70" />

        <!-- Bottom Gradient Scrim for Crisp Text Readability -->
        <BoxView VerticalOptions="End"
                 HeightRequest="180"
                 InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0015042C" Offset="0.0" />
                    <GradientStop Color="#AA15042C" Offset="0.55" />
                    <GradientStop Color="#EE100222" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Glassmorphic Status Capsule -->
        <Border x:Name="StatusContainer"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="24,0,24,48"
                Padding="18,10"
                StrokeThickness="1"
                Stroke="#40F472B6"
                BackgroundColor="#951B0738"
                Opacity="0"
                TranslationY="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#F472B6"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Center" />

                <Label Text="{Binding StatusMessage}"
                       FontFamily="CairoBold"
                       FontSize="13"
                       TextColor="#F8FAFC"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Version Footer -->
        <Label x:Name="VersionFooter"
               Text="BetweenUs v1.0 • A little world, just for two"
               FontFamily="CairoRegular"
               FontSize="11"
               TextColor="#C4B5FD"
               Opacity="0"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,18" />
    </Grid>

</ContentPage>
