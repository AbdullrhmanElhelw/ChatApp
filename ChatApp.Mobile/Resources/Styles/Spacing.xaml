<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BetweenUs Design System v1.0 — 4px Spacing Tokens -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">20</x:Double>
    <x:Double x:Key="Spacing2XL">24</x:Double>
    <x:Double x:Key="Spacing3XL">32</x:Double>
    <x:Double x:Key="Spacing4XL">48</x:Double>

    <!-- BetweenUs Design System v1.0 — Border Radius Tokens -->
    <x:Double x:Key="RadiusSmallButton">10</x:Double>
    <x:Double x:Key="RadiusIconContainer">12</x:Double>
    <x:Double x:Key="RadiusTextField">14</x:Double>
    <x:Double x:Key="RadiusCard">20</x:Double>
    <x:Double x:Key="RadiusDialog">24</x:Double>
    <x:Double x:Key="RadiusBottomSheet">28</x:Double>

</ResourceDictionary>
