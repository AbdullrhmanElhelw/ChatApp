<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChatApp.Mobile.Features.Conversations.ViewModels"
             xmlns:dtos="clr-namespace:ChatApp.Mobile.Features.Conversations.DTOs"
             xmlns:controls="clr-namespace:ChatApp.Mobile.Controls"
             x:Class="ChatApp.Mobile.Features.Conversations.Pages.ConversationsPage"
             x:DataType="vm:ConversationsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0">

        <!-- 1. Modern Top Header (Telegram / Signal Style) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,14" VerticalOptions="Center">
            <!-- Brand & Current User -->
            <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                <controls:AvatarView FullName="{Binding CurrentUser.FullName}"
                                     AvatarUrl="{Binding CurrentUser.AvatarUrl}"
                                     Size="42"
                                     IsOnline="True" />
                <Label Text="ChatApp"
                       FontFamily="CairoBold"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandPrimary}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Actions: Search, Theme Toggle & Logout (Vector Icons) -->
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <!-- Theme Toggle -->
                <Border WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{AppThemeBinding Light={StaticResource IconMoon}, Dark={StaticResource IconSun}}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Search -->
                <Border WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenUserSearchCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconSearch}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Logout -->
                <Border WidthRequest="38"
                        HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconLogout}"
                          Fill="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- 2. Search Bar (Luxury Pill) -->
        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                Padding="16,0"
                HeightRequest="44"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                <Path Grid.Column="0"
                      Data="{StaticResource IconSearch}"
                      Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                      WidthRequest="16"
                      HeightRequest="16"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="ابحث في المحادثات أو الرسائل..."
                       FontFamily="CairoRegular"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- 3. Category Filter Tabs -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <Border BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeThickness="0"
                    Padding="14,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="الكل"
                       FontFamily="CairoBold"
                       FontSize="12"
                       TextColor="{StaticResource White}" />
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    StrokeThickness="0"
                    Padding="14,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="غير مقروءة"
                       FontFamily="CairoBold"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                    StrokeThickness="0"
                    Padding="14,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="المجموعات"
                       FontFamily="CairoBold"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </Border>
        </HorizontalStackLayout>

        <!-- 4. Conversations List / RefreshView -->
        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{StaticResource BrandPrimary}">

                <CollectionView ItemsSource="{Binding FilteredConversations}"
                                SelectionMode="None">

                    <!-- Empty State View -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="24"
                                             IsVisible="{Binding IsEmpty}">
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36" />
                                </Border.StrokeShape>
                                <Path Data="{StaticResource IconEdit}"
                                      Fill="{StaticResource BrandPrimary}"
                                      WidthRequest="32"
                                      HeightRequest="32"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>

                            <Label Text="لا توجد محادثات حتى الآن"
                                   Style="{StaticResource TypographyH2}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray100}}"
                                   HorizontalOptions="Center" />

                            <Label Text="ابدأ محادثتك الأولى الآن وتواصل فورياً مع أصدقائك ومجموعاتك!"
                                   Style="{StaticResource TypographyBody}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="300" />

                            <Border BackgroundColor="{StaticResource BrandPrimary}"
                                    StrokeThickness="0"
                                    Padding="20,10"
                                    Margin="0,12,0,0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenUserSearchCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconSearch}"
                                          Fill="{StaticResource White}"
                                          WidthRequest="16"
                                          HeightRequest="16"
                                          Aspect="Uniform"
                                          VerticalOptions="Center" />
                                    <Label Text="البحث عن مستخدمين وبدء محادثة"
                                           FontFamily="CairoBold"
                                           FontSize="13"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Conversation Card Item Template -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:ConversationSummaryDto">
                            <Border Margin="0,0,0,8"
                                    Padding="14,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConversationsViewModel}}, Path=SelectConversationCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Participant Avatar with Online Presence -->
                                    <controls:AvatarView Grid.Column="0"
                                                         FullName="{Binding Title}"
                                                         AvatarUrl="{Binding AvatarUrl}"
                                                         Size="50"
                                                         IsOnline="{Binding IsOtherParticipantOnline}"
                                                         VerticalOptions="Center" />

                                    <!-- Middle Details: Title & Message Preview -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="CairoBold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding LastMessagePreview}"
                                               FontFamily="CairoRegular"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>

                                    <!-- Right Meta: Timestamp & Unread Badge -->
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="6"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding FormattedTime}"
                                               FontFamily="CairoRegular"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               HorizontalOptions="End" />

                                        <controls:BadgeIndicator Count="{Binding UnreadCount}"
                                                                 HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Floating Action Button (New Chat FAB) -->
            <Border WidthRequest="56"
                    HeightRequest="56"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,16,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BrandPrimary}" Offset="0,4" Radius="8" Opacity="0.45" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenUserSearchCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconEdit}"
                      Fill="{StaticResource White}"
                      WidthRequest="20"
                      HeightRequest="20"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>

</ContentPage>
